    <node id="Pass@1">
      <data key="d0">Pass@1</data>
      <data key="d1">metric</data>
      <data key="d2">Pass@1 is a metric used to evaluate the performance of generative recommendation models, measuring the proportion of users who receive at least one relevant item in their top-1 list.</data>

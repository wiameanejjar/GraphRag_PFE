    <node id="System Model Security Inference">
      <data key="d0">System Model Security Inference</data>
      <data key="d1">concept</data>
      <data key="d2">System Model Security Inference refers to the process of inferring security threats and vulnerabilities in cyber-physical systems using system models.</data>

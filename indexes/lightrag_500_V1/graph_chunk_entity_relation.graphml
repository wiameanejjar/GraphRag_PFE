    <node id="AdaMamba">
      <data key="d0">AdaMamba</data>
      <data key="d1">method</data>
      <data key="d2">AdaMamba is a novel framework for long-term time series forecasting that integrates frequency-domain analysis with temporal dependency learning.</data>

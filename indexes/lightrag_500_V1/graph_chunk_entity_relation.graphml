    <node id="Autonomous Robots">
      <data key="d0">Autonomous Robots</data>
      <data key="d1">artifact</data>
      <data key="d2">Autonomous robots are the entities that operate in open environments and need to continuously handle uncovered tasks.</data>
      <data key="d3">chunk-70ca0e5d7abfb4851dc541e18cb0657f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206288</data>

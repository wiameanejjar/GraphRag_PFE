    </node>
    <node id="Collision Radius Inflation">
      <data key="d0">Collision Radius Inflation</data>
      <data key="d1">component</data>
      <data key="d2">Collision radius inflation is a perception-level adaptation technique used by AsyncShield to improve physical safety during navigation.</data>
      <data key="d3">chunk-047ce2bc252a55d9055c31539d3a7c47</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779157522</data>
      <data key="d6" />
    </node>
    <node id="Kerimov-Alekberli Model">
      <data key="d0">Kerimov-Alekberli Model</data>
      <data key="d1">model</data>
      <data key="d2">The Kerimov-Alekberli model is an information-geometric framework for real-time system stability that redefines AI safety by linking non-equilibrium thermodynamics to stochastic control.</data>
      <data key="d3">chunk-d10488f697007297062eb31177c84c90</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779157746</data>

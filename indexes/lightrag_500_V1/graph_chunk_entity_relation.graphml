    <node id="Adaptive Programming Practice">
      <data key="d0">Adaptive Programming Practice</data>
      <data key="d1">method</data>
      <data key="d2">Adaptive programming practice involves tailoring educational content to individual students' needs, often relying on fixed libraries of worked examples and practice problems.</data>
      <data key="d3">chunk-421873c316a2a72fa1ccf5068ebdfe92</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779062934</data>
      <data key="d6" />
    </node>
    <node id="Student Code Submissions">
      <data key="d0">Student Code Submissions</data>
      <data key="d1">dataset</data>
      <data key="d2">Student code submissions are used as input for the approach, providing insights into students' logical errors and partial solutions.</data>
      <data key="d3">chunk-421873c316a2a72fa1ccf5068ebdfe92</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779062941</data>

      <data key="d0">BEIR Benchmark Datasets</data>
      <data key="d1">dataset</data>
      <data key="d2">The BEIR benchmark datasets are used to evaluate ResRank's performance on various ranking tasks.</data>
      <data key="d3">chunk-35d6e4ada5453c7cde973c876f445327</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206802</data>

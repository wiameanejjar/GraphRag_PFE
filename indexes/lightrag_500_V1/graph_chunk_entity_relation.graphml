      <data key="d3">chunk-db8ced0136efaaf767c85f4c9e185dbe</data>
      <data key="d2">GPT-5 uses safe completion as a safeguard against jailbreaking.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779157968</data>
      <data key="d6" />
    </node>
    <node id="The Pragmatic Persona">
      <data key="d0">The Pragmatic Persona</data>
      <data key="d1">concept</data>
      <data key="d2">The Pragmatic Persona is a concept that explores the discovery of LLM personas through bridging inference.</data>
      <data key="d3">chunk-090dd9c7587ef7f5e03426647d58470b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779158112</data>
      <data key="d6" />
    </node>
    <node id="Cognitive Discourse Theory">
      <data key="d0">Cognitive Discourse Theory</data>
      <data key="d1">concept</data>
      <data key="d2">Cognitive Discourse Theory is a framework that interprets LLM dialogue through bridging inference -- implicit conceptual relations that connect utterances via shared world knowledge and discourse coherence.</data>
      <data key="d3">chunk-090dd9c7587ef7f5e03426647d58470b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779158119</data>
      <data key="d6" />
    </node>
    <node id="Bridging Inference Graphs">
      <data key="d0">Bridging Inference Graphs</data>
      <data key="d1">method</data>
      <data key="d2">Bridging Inference Graphs are structured knowledge graphs that model the relations between utterances as shared world knowledge and discourse coherence, enabling persona discovery at the level of discourse coherence rather than surface realizations.</data>
      <data key="d3">chunk-090dd9c7587ef7f5e03426647d58470b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779158119</data>
      <data key="d6" />
    </node>
    <node id="Persona Traits">
      <data key="d0">Persona Traits</data>
      <data key="d1">concept</data>
      <data key="d2">Persona traits are consistently encoded in the structural organization of discourse rather than isolated lexical patterns.</data>
      <data key="d3">chunk-090dd9c7587ef7f5e03426647d58470b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779158124</data>
      <data key="d6" />
    </node>
    <node id="An Information-Geometric Framework for Stability Analysis of Large Language Models under Entropic Stress">
      <data key="d0">An Information-Geometric Framework for Stability Analysis of Large Language Models under Entropic Stress</data>
      <data key="d1">concept</data>
      <data key="d2">This study proposes a thermodynamic inspired modeling framework for analyzing the stability of LLM outputs under conditions of uncertainty and perturbation.</data>
      <data key="d3">chunk-ddabb643ad7982794978859b96daf403</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779158369</data>
      <data key="d6" />
    </node>

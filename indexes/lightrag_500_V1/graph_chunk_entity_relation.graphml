      <data key="d6" />
    </node>
    <node id="EAR">
      <data key="d0">EAR</data>
      <data key="d1">method</data>
      <data key="d2">EAR is an editing-as-reasoning paradigm that reformulates visual planning as a single-step image transformation.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212093</data>
      <data key="d6" />
    </node>
    <node id="AMAZE">
      <data key="d0">AMAZE</data>
      <data key="d1">dataset</data>
      <data key="d2">AMAZE is a procedurally generated dataset that features the classical Maze and Queen problems, covering distinct, complementary forms of visual planning.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212098</data>
      <data key="d6" />
    </node>
    <node id="Maze Problem">
      <data key="d0">Maze Problem</data>
      <data key="d1">concept</data>
      <data key="d2">The Maze problem is one of the probing tasks used to isolate intrinsic reasoning from visual recognition in AMAZE.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212098</data>

    <node id="FeatEHR-LLM">
      <data key="d0">FeatEHR-LLM</data>
      <data key="d1">method</data>
      <data key="d2">FeatEHR-LLM is a framework that leverages Large Language Models to generate clinically meaningful tabular features from irregularly sampled EHR time series.</data>
      <data key="d3">chunk-4fab3e7e7679978c148a365b9ea6284a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779199665</data>
      <data key="d6" />
    </node>
    <node id="Electronic Health Records (EHR)">
      <data key="d0">Electronic Health Records (EHR)</data>
      <data key="d1">dataset</data>
      <data key="d2">Electronic Health Records are clinical time series data with irregular observation intervals, variable measurement frequencies, and structural sparsity.</data>
      <data key="d3">chunk-4fab3e7e7679978c148a365b9ea6284a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779199665</data>
      <data key="d6" />
    </node>
    <node id="Dataset Schemas">
      <data key="d0">Dataset Schemas</data>
      <data key="d1">dataset</data>
      <data key="d2">Dataset schemas and task descriptions are used by the LLM to operate exclusively on them rather than raw patient records, limiting patient privacy exposure.</data>
      <data key="d3">chunk-4fab3e7e7679978c148a365b9ea6284a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779199672</data>
      <data key="d6" />
    </node>

      <data key="d0">Logic Gate Networks (LGNs)</data>
      <data key="d1">method</data>
      <data key="d2">Logic Gate Networks are compact, logic-based representations that replace conventional floating-point feature extractors in the framework.</data>
      <data key="d3">chunk-baaa108812ca4e7943f0f7559bc8aec0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779218510</data>

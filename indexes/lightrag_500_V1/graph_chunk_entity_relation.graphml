    <node id="Host RAM">
      <data key="d0">Host RAM</data>
      <data key="d1">equipment</data>
      <data key="d2">MTServe leverages host RAM as a scalable backup store to virtualize GPU memory.</data>
      <data key="d3">chunk-3dc81f5a7528411e1220bc62eebacde1</data>

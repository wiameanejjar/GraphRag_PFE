    </node>
    <node id="Graves' Initialization Scheme">
      <data key="d0">Graves' Initialization Scheme</data>
      <data key="d1">method</data>
      <data key="d2">Graves' initialization scheme is a method for initializing the memory tokens in the Universal Transformer, which involves setting the bias to a positive value (p ~ 0.73).</data>
      <data key="d3">chunk-ad110990ca6cc9a17e5632b94fa3fe51</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212276</data>

      <data key="d1">method</data>
      <data key="d2">The Automated Semantic Annotation Pipeline automatically transforms raw segmentation masks into grounded, hierarchical instruction sets for interactive reasoning.</data>
      <data key="d3">chunk-f110f83c4981b4fb0a0f629368577657</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779203186</data>

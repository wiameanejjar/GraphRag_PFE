      <data key="d0">Prototype Anchoring</data>
      <data key="d1">concept</data>
      <data key="d2">Prototype anchoring helps unimodal clients align with global cross-modal semantics in RCSR.</data>
      <data key="d3">chunk-9d10efc0c92804139d9299a38bbb33d5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779202923</data>
      <data key="d6" />
    </node>
    <node id="Semantic Routing">
      <data key="d0">Semantic Routing</data>
      <data key="d1">method</data>
      <data key="d2">Semantic routing is a component of RCSR that adaptively assigns aggregation weights based on retrieval consistency to mitigate alignment drift during heterogeneous updates.</data>
      <data key="d3">chunk-9d10efc0c92804139d9299a38bbb33d5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779202923</data>

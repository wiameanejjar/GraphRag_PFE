      <data key="d5">1779207492</data>
      <data key="d6" />
    </node>
    <node id="Expert Evaluation">
      <data key="d0">Expert Evaluation</data>
      <data key="d1">method</data>
      <data key="d2">Expert evaluation is used to compare baseline and KC-conditioned outputs, assessing their topical focus and relevance to learners' underlying logical errors.&lt;SEP&gt;Expert evaluation is used to identify systematic misalignment between LLMs' judgments.</data>
      <data key="d3">chunk-421873c316a2a72fa1ccf5068ebdfe92&lt;SEP&gt;chunk-ceb637d4c7b6b73e3fb46616c67758ed</data>

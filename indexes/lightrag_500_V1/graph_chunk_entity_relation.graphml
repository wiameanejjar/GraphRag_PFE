      <data key="d0">Knowledge Lever Risk Management Framework</data>
      <data key="d1">concept</data>
      <data key="d2">The Knowledge Lever Risk Management Framework is a stochastic framework designed for mitigating knowledge loss in software engineering projects.</data>
      <data key="d3">chunk-850916db00ea50f06ff31f9e7e9ec9e5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779187170</data>
      <data key="d6" />
    </node>
    <node id="Software Engineering Organizations">
      <data key="d0">Software Engineering Organizations</data>
      <data key="d1">organization</data>
      <data key="d2">Software engineering organizations operate in a knowledge-intensive domain where critical assets are overwhelmingly tacit and volatile.</data>
      <data key="d3">chunk-850916db00ea50f06ff31f9e7e9ec9e5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779187170</data>

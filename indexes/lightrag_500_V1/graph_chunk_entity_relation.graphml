    <node id="GPU Memory">
      <data key="d0">GPU Memory</data>
      <data key="d1">equipment</data>
      <data key="d2">GPU memory is used by MTServe but has physical limits that create storage explosions for individual user states.</data>
      <data key="d3">chunk-3dc81f5a7528411e1220bc62eebacde1</data>

    <node id="Catastrophic Overfitting">
      <data key="d0">Catastrophic Overfitting</data>
      <data key="d1">concept</data>
      <data key="d2">Catastrophic Overfitting refers to models overfitting to specific attack used during training and failing to generalize to others.</data>
      <data key="d3">chunk-1275d6a1c7d7e5d54c4d93057e8775c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779150574</data>
      <data key="d6" />
    </node>
    <node id="Backdoor Mechanism">
      <data key="d0">Backdoor Mechanism</data>
      <data key="d1">concept</data>
      <data key="d2">The Backdoor Mechanism is a theoretical framework that interprets Catastrophic Overfitting as a weak trigger variant of unlearnable tasks, unifying CO, backdoor attacks, and unlearnable tasks under a common framework.</data>
      <data key="d3">chunk-1275d6a1c7d7e5d54c4d93057e8775c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779150581</data>

    </node>
    <node id="A Taxonomy and Resolution Strategy for Client-Level Disagreements in Federated Learning">
      <data key="d0">A Taxonomy and Resolution Strategy for Client-Level Disagreements in Federated Learning</data>
      <data key="d1">dataset</data>
      <data key="d2">This paper addresses the gap of client-level disagreements by introducing a taxonomy and proposing a robust resolution strategy.</data>
      <data key="d3">chunk-7b76b69fbc52715fc463c5d181400ff4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779182803</data>

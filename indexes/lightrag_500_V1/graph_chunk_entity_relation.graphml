    <node id="PhysNote">
      <data key="d0">PhysNote</data>
      <data key="d1">dataset</data>
      <data key="d2">PhysNote is an agentic framework that enables Vision-Language Models to externalize and refine physical knowledge through self-generated "Knowledge Notes."</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">unknown_source</data>

    </node>
    <node id="\model">
      <data key="d0">\model</data>
      <data key="d1">model</data>
      <data key="d2">\model is a modular strategy-space layer that elevates natural-language strategy descriptions from transient prompt context to first-class population-level evolutionary state in LLM-driven program search.</data>
      <data key="d3">chunk-40da9bd6834b701e84e700fdf93b5c3c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149570</data>

    <node id="Adaptive Computation Time">
      <data key="d0">Adaptive Computation Time</data>
      <data key="d1">method</data>
      <data key="d2">Adaptive Computation Time is an algorithmic technique used to dynamically adjust the computational resources allocated to different parts of the Universal Transformer.</data>
      <data key="d3">chunk-ad110990ca6cc9a17e5632b94fa3fe51</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212265</data>
      <data key="d6" />
    </node>
    <node id="Sudoku-Extreme">
      <data key="d0">Sudoku-Extreme</data>
      <data key="d1">dataset</data>
      <data key="d2">Sudoku-Extreme is a combinatorial reasoning benchmark used for evaluating the performance of adaptive recursive reasoning models.</data>
      <data key="d3">chunk-ad110990ca6cc9a17e5632b94fa3fe51</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212272</data>

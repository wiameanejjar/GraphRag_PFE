      <data key="d1">artifact</data>
      <data key="d2">EOG interference severely degrades EEG signal quality and hinders reliable interpretation in applications such as neurological diagnosis and brain-computer interfaces.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779148433</data>

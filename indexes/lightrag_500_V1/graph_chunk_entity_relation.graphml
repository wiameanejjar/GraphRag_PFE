      <data key="d0">Probing Visual Planning in Image Editing Models</data>
      <data key="d1">concept</data>
      <data key="d2">Probing Visual Planning in Image Editing Models is a research paper that explores visual planning in image editing models.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212087</data>
      <data key="d6" />
    </node>
    <node id="Visual Planning">
      <data key="d0">Visual Planning</data>
      <data key="d1">concept</data>
      <data key="d2">Visual Planning represents a crucial facet of human intelligence, especially in tasks that require complex spatial reasoning and navigation.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212087</data>
      <data key="d6" />
    </node>
    <node id="Machine Learning">
      <data key="d0">Machine Learning</data>
      <data key="d1">fieldofstudy</data>
      <data key="d2">Machine learning is the field where visual planning is often tackled through a verbal-centric lens.&lt;SEP&gt;Machine Learning is a field that contributes to the development of AI systems.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed&lt;SEP&gt;chunk-a0358c86a3f37fe89507f87e2710efdf</data>

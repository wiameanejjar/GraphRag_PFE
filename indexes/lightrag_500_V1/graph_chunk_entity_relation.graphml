    <node id="Reconstructive Authority Model (RAM)">
      <data key="d0">Reconstructive Authority Model (RAM)</data>
      <data key="d1">concept</data>
      <data key="d2">The Reconstructive Authority Model is a framework that separates integrity from coverage in autonomous systems operating under partial observability.</data>
      <data key="d3">chunk-c76cc454c5e1f693609cbf2d13755e39</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779199835</data>
      <data key="d6" />
    </node>
    <node id="Autonomous Systems">
      <data key="d0">Autonomous Systems</data>
      <data key="d1">category</data>
      <data key="d2">Autonomous systems are self-governing entities that operate under partial observability, where execution-relevant state is never fully accessible.</data>
      <data key="d3">chunk-c76cc454c5e1f693609cbf2d13755e39</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779199835</data>
      <data key="d6" />
    </node>

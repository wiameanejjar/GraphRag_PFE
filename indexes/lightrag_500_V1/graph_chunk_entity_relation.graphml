    <node id="Discrete Latent Compression">
      <data key="d0">Discrete Latent Compression</data>
      <data key="d1">method</data>
      <data key="d2">This method compresses high-dimensional raw signals into compact discrete representations using a categorical variational autoencoder with Gumbel-Softmax latent variables under a capacity-controlled objective.</data>
      <data key="d3">chunk-75b1e120664fd0493cc36157d635b118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779194782</data>
      <data key="d6" />
    </node>
    <node id="LTL Rule Extraction">
      <data key="d0">LTL Rule Extraction</data>
      <data key="d1">method</data>
      <data key="d2">This method extracts Linear Temporal Logic (LTL) rules from the compressed CSI data to produce a fully symbolic and deterministic classifier based solely on rule evaluation and aggregation.</data>
      <data key="d3">chunk-75b1e120664fd0493cc36157d635b118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779194786</data>

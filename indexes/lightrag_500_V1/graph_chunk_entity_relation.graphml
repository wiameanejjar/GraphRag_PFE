      <data key="d0">EconCausal Benchmark</data>
      <data key="d1">dataset</data>
      <data key="d2">The EconCausal benchmark is extended with ideology-contested cases to evaluate LLMs' ability to predict empirically supported causal directions.</data>
      <data key="d3">chunk-a83603d60645957cf376cc8d4c3dc750</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779227702</data>

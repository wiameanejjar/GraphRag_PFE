    <node id="Promotion Algorithm">
      <data key="d0">Promotion Algorithm</data>
      <data key="d1">method</data>
      <data key="d2">The promotion algorithm is an ensemble method that dynamically selects between two active models during inference.</data>
      <data key="d3">chunk-02d9ec7d187174eea2463881c8062a3a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779219940</data>
      <data key="d6" />

    </node>
    <node id="Hybrid Equations">
      <data key="d0">Hybrid Equations</data>
      <data key="d1">concept</data>
      <data key="d2">Hybrid equations model hybrid dynamical systems by combining differential and difference equations with inputs and constraints.</data>
      <data key="d3">chunk-014b8ae28e95cbf89d881af21e70a6b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212515</data>

    <node id="AEL">
      <data key="d0">AEL</data>
      <data key="d1">concept</data>
      <data key="d2">AEL (Agent Evolving Learning) is a two-timescale framework for addressing the obstacle of using past experience in open-ended environments.</data>
      <data key="d3">chunk-6493a88a5a5c0fd31a6f09528518bb40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217966</data>

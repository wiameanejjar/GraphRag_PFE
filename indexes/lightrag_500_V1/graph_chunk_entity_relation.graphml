      <data key="d0">IST-20 Benchmarking Protocol</data>
      <data key="d1">dataset</data>
      <data key="d2">The IST-20 benchmarking protocol is used to analyze the stability of LLM outputs across four contemporary models.</data>
      <data key="d3">chunk-ddabb643ad7982794978859b96daf403</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779158376</data>
      <data key="d6" />
    </node>
    <node id="Internal Integration">
      <data key="d0">Internal Integration</data>
      <data key="d1">metric</data>
      <data key="d2">Internal integration is one of the internal structural proxies used in the proposed framework to modulate the impact of disorder on model behavior.</data>
      <data key="d3">chunk-ddabb643ad7982794978859b96daf403</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779158376</data>

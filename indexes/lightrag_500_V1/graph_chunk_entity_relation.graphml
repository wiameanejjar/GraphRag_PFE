      <data key="d0">Cancer Survival Prediction</data>
      <data key="d1">task</data>
      <data key="d2">Cancer survival prediction from multi-omics data remains challenging due to high-dimensional, heterogeneous, and distributed prognostic signals across interacting genes and pathways.</data>
      <data key="d3">chunk-a78592bca66f2cefa305ee606ed12b84</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149750</data>

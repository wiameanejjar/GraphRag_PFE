    <node id="Queen Problem">
      <data key="d0">Queen Problem</data>
      <data key="d1">concept</data>
      <data key="d2">The Queen problem is another probing task used to isolate intrinsic reasoning from visual recognition in AMAZE.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>

    <node id="Dual-Level Attention Mechanism">
      <data key="d0">Dual-Level Attention Mechanism</data>
      <data key="d1">method</data>
      <data key="d2">PathMoG uses dual-level attention to capture both intra-pathway driver signals and inter-pathway clinical relevance.</data>

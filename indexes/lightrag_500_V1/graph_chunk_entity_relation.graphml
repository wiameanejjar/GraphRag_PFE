    <node id="Context-Fragmented Violations">
      <data key="d0">Context-Fragmented Violations</data>
      <data key="d1">concept</data>
      <data key="d2">Context-Fragmented Violations are policy breaches where individual agent actions appear safe but collectively violate organizational policies due to siloed critical policy facts.</data>
      <data key="d3">chunk-71069a5345037996a5ed3ee296df014f</data>
      <data key="d4">unknown_source</data>

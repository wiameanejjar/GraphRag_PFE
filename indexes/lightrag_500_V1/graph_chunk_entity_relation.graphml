    <node id="Pattern-based Knowledge Components">
      <data key="d0">Pattern-based Knowledge Components</data>
      <data key="d1">concept</data>
      <data key="d2">Pattern-based knowledge components are extracted from student code through AST-based analysis to guide educational content generation.</data>
      <data key="d3">chunk-421873c316a2a72fa1ccf5068ebdfe92</data>
      <data key="d4">unknown_source</data>

    <node id="Jailbreaking Frontier Foundation Models Through Intention Deception">
      <data key="d0">Jailbreaking Frontier Foundation Models Through Intention Deception</data>
      <data key="d1">dataset</data>
      <data key="d2">The dataset is a collection of research papers and models related to jailbreaking frontier models through intention deception.</data>
      <data key="d3">chunk-db8ced0136efaaf767c85f4c9e185dbe</data>

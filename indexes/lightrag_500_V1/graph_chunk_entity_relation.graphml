      <data key="d5">1779212106</data>
      <data key="d6" />
    </node>
    <node id="Proprietary Editing Models">
      <data key="d0">Proprietary Editing Models</data>
      <data key="d1">model</data>
      <data key="d2">Proprietary editing models struggle in the zero-shot setting, finetuning on basic scales enables remarkable generalization to larger in-domain scales and out-of-domain scales and geometries.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>

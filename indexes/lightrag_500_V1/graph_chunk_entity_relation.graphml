    <node id="Their Designers">
      <data key="d0">Their Designers</data>
      <data key="d1">person</data>
      <data key="d2">The designers of AI systems are humans who create the moral frameworks for these systems, influencing how they make decisions.</data>
      <data key="d3">chunk-bbf5cdde0215fa8979b16920619610f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779155754</data>
      <data key="d6" />
    </node>

    </node>
    <node id="SAGA-ReID">
      <data key="d0">SAGA-ReID</data>
      <data key="d1">method</data>
      <data key="d2">SAGA-ReID is a proposed method that reconstructs identity representations by aligning intermediate patch tokens with anchor vectors parameterized in CLIP's text embedding space.</data>
      <data key="d3">chunk-2a45bf678ca7078a36ca306ecefdd317</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206617</data>
      <data key="d6" />
    </node>

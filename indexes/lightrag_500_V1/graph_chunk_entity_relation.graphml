    </edge>
    <edge source="Adam" target="Adaptive Decoupled Moment Routing">
      <data key="d7">1.0</data>
      <data key="d8">The second-moment pathway of Adam is addressed by adaptive decoupled moment routing, which routes the modified gradient only to the first moment while preserving magnitude-faithful second-moment statistics.</data>
      <data key="d9">method comparison,optimization algorithm</data>
      <data key="d10">chunk-350265fa6cfa6c36f900b8cfb64b92be</data>

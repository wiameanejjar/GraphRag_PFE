      <data key="d0">Opus 4.7 Preview</data>
      <data key="d1">model</data>
      <data key="d2">Opus 4.7 Preview is another Claude model used in the study, exhibiting notably elevated unprompted evaluation awareness but low prefill awareness.</data>
      <data key="d3">chunk-7a6ae8adcf4df680a3155bbab7deb847</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142869</data>
      <data key="d6" />
    </node>
    <node id="Petri">
      <data key="d0">Petri</data>
      <data key="d1">tool</data>
      <data key="d2">Petri is an open-source LLM auditing tool used to build the evaluation framework for assessing sabotage propensity.</data>

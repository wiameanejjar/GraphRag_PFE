      <data key="d1">protocol</data>
      <data key="d2">The STT Protocol enables security state propagation across organizational boundaries without exposing raw cross-domain data.</data>
      <data key="d3">chunk-71069a5345037996a5ed3ee296df014f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206949</data>

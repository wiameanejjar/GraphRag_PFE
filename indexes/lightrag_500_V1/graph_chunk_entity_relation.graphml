    </node>
    <node id="Organisational Support">
      <data key="d0">Organisational Support</data>
      <data key="d1">concept</data>
      <data key="d2">Organisational support also plays a crucial role in fostering psychological safety and disclosure intention among university students.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217804</data>

      <data key="d1">method</data>
      <data key="d2">The Hierarchical Omics Modulation module conditions gene-expression representations on mutation, copy number variation, pathway, and clinical context.</data>
      <data key="d3">chunk-a78592bca66f2cefa305ee606ed12b84</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149757</data>

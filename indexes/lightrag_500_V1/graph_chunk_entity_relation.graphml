    <node id="Undecidability Proof">
      <data key="d0">Undecidability Proof</data>
      <data key="d1">concept</data>
      <data key="d2">The Undecidability Proof shows that the plan existence problem is undecidable, even with certain restrictions on the preconditions of epistemic actions.</data>

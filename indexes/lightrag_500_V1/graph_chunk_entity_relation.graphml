      <data key="d1">concept</data>
      <data key="d2">The Hybrid AI Framework for Demand-Supply Forecasting and Optimization is a proposed framework that integrates demand forecasting with supply chain optimization.</data>
      <data key="d3">chunk-75a43a690593dff8fe9445303121d6d7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779221253</data>
      <data key="d6" />
    </node>
    <node id="Long Short-Term Memory (LSTM)-based demand forecasting module">
      <data key="d0">Long Short-Term Memory (LSTM)-based demand forecasting module</data>
      <data key="d1">method</data>
      <data key="d2">The LSTM-based demand forecasting module captures temporal and contextual demand dependencies within the HAF-DS framework.</data>

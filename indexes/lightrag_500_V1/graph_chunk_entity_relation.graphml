    <node id="Frequency-Domain Analysis">
      <data key="d0">Frequency-Domain Analysis</data>
      <data key="d1">concept</data>
      <data key="d2">Frequency-domain analysis is a method for analyzing time series data by examining its frequency components rather than its temporal structure.</data>
      <data key="d3">chunk-c4d3f5bf88d1c43459b79a491fd32f08</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779188016</data>

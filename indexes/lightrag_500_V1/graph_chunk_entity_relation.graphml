      <data key="d0">Structured Large Language Model Reasoning Module</data>
      <data key="d1">method</data>
      <data key="d2">The LLM module evaluates the candidate signal actions using structured traffic-state inputs and produces congestion diagnoses, phase adjustment recommendations, and natural-language explanations.</data>
      <data key="d3">chunk-5afcc78472e920445d94dd9f10ec59ab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779165856</data>
      <data key="d6" />
    </node>
    <node id="Safety Filter">
      <data key="d0">Safety Filter</data>
      <data key="d1">method</data>
      <data key="d2">The safety filter validates all LLM-generated recommendations before execution to ensure operational reliability.</data>
      <data key="d3">chunk-5afcc78472e920445d94dd9f10ec59ab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779165861</data>

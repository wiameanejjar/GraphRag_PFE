      <data key="d0">Simulation Experiments</data>
      <data key="d1">task</data>
      <data key="d2">Simulation experiments are conducted to evaluate the performance of ResVLA in comparison with standard generative baselines.</data>
      <data key="d3">chunk-184da693de71f9b2b2481b01afaf1e16</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779226048</data>
      <data key="d6" />
    </node>
    <node id="Real-World Robot Experiments">
      <data key="d0">Real-World Robot Experiments</data>
      <data key="d1">task</data>
      <data key="d2">ResVLA is also evaluated in real-world robot experiments, demonstrating strong performance and robustness.</data>
      <data key="d3">chunk-184da693de71f9b2b2481b01afaf1e16</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779226048</data>

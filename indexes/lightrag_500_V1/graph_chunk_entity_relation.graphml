    <node id="Sequential Adaptation">
      <data key="d0">Sequential Adaptation</data>
      <data key="d1">method</data>
      <data key="d2">Sequential adaptation involves updating the neural model to adapt to new documents, but it can induce catastrophic forgetting.</data>

      <data key="d0">Emotion-Category Lexicon</data>
      <data key="d1">dataset</data>
      <data key="d2">The emotion-category lexicon is a dataset used for evaluating the performance of language models in detecting emotions.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779172083</data>
      <data key="d6" />
    </node>
    <node id="Contextual Transformer Classifier">
      <data key="d0">Contextual Transformer Classifier</data>
      <data key="d1">method</data>
      <data key="d2">The contextual transformer classifier is a machine learning model that uses contextual information to classify text into different categories, including emotions.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>

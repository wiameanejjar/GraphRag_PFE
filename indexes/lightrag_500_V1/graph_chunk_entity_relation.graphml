      <data key="d4">unknown_source</data>
      <data key="d5">1779148254</data>
      <data key="d6" />
    </node>
    <node id="BandRouteNet">
      <data key="d0">BandRouteNet</data>
      <data key="d1">model</data>
      <data key="d2">BandRouteNet is an adaptive frequency-aware neural network designed for EEG denoising that jointly exploits band-specific processing and full-band contextual modeling.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779148426</data>

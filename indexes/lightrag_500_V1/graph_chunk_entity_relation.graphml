    <node id="GenMatter">
      <data key="d0">GenMatter</data>
      <data key="d1">dataset</data>
      <data key="d2">GenMatter is a generative model that hierarchically groups low-level motion cues and high-level appearance features into particles, capturing coherently and independently moveable physical entities.</data>
      <data key="d3">chunk-a796b36576b3a3580d3e19194a2554bd</data>

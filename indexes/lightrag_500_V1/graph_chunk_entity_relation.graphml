    <node id="GAN-based Models">
      <data key="d0">GAN-based Models</data>
      <data key="d1">method</data>
      <data key="d2">GAN-based models are used as fully generative tabular synthesizers that can achieve strong train-on-synthetic-test-on-real performance while distorting causal estimands such as the average treatment effect (ATE).</data>
      <data key="d3">chunk-755055e56a32b2634be9cdc8f1d609c2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779165691</data>

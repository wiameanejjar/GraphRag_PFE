    </node>
    <node id="Softmax Attention">
      <data key="d0">Softmax Attention</data>
      <data key="d1">method</data>
      <data key="d2">Softmax attention is a standard attention mechanism used in many models but exhibits quadratic time complexity with respect to sequence length.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779148241</data>

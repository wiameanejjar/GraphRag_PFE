    <node id="AdaMamba Framework">
      <data key="d0">AdaMamba Framework</data>
      <data key="d1">concept</data>
      <data key="d2">The AdaMamba framework is a methodological approach to adaptive and context-aware frequency analysis in time series forecasting.</data>

    <node id="Sigmoid Function">
      <data key="d0">Sigmoid Function</data>
      <data key="d1">concept</data>
      <data key="d2">The Sigmoid function is a widely used nonlinear activation function in artificial neural networks for probabilistic output and binary classification.</data>

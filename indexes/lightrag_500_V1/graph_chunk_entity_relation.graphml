    </node>
    <node id="Evaluation Apprehension">
      <data key="d0">Evaluation Apprehension</data>
      <data key="d1">metric</data>
      <data key="d2">Evaluation apprehension reduces disclosure intention and psychological safety, as revealed by the study's results.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>

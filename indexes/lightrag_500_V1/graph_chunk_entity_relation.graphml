    <node id="Vision-Language Model">
      <data key="d0">Vision-Language Model</data>
      <data key="d1">concept</data>
      <data key="d2">A Vision-Language Model is a type of artificial intelligence model that integrates computer vision and natural language processing capabilities.</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779148011</data>

    <node id="Universal Transformers">
      <data key="d0">Universal Transformers</data>
      <data key="d1">concept</data>
      <data key="d2">Universal Transformers are a type of neural network architecture that can be used for adaptive recursive reasoning.</data>
      <data key="d3">chunk-ad110990ca6cc9a17e5632b94fa3fe51</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212265</data>

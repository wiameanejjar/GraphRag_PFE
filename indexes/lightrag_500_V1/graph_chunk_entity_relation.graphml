    <node id="Symbolic Regression">
      <data key="d0">Symbolic Regression</data>
      <data key="d1">concept</data>
      <data key="d2">Symbolic regression is a method for discovering mathematical formulas from data by training models with learnable weights and optimizing them using gradient descent.</data>
      <data key="d3">chunk-860a403403cae4a9abe1d06031eb3780</data>
      <data key="d4">unknown_source</data>

    <node id="Diffusion Templates">
      <data key="d0">Diffusion Templates</data>
      <data key="d1">dataset</data>
      <data key="d2">Diffusion Templates is a unified plugin framework for controllable diffusion methods that decouples base-model inference from capability injection.</data>

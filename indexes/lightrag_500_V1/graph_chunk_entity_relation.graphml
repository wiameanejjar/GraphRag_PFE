    </node>
    <node id="ESRRSim">
      <data key="d0">ESRRSim</data>
      <data key="d1">method</data>
      <data key="d2">ESRRSim is an agentic framework for automated behavioral risk evaluation that generates scenarios to elicit faithful reasoning and assesses model responses and reasoning traces.</data>
      <data key="d3">chunk-e8778c4326e5372d8016fc296ebdc67e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779208160</data>
      <data key="d6" />
    </node>

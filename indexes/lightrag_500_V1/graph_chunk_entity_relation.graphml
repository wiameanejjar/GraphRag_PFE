      <data key="d6" />
    </node>
    <node id="Palabrita">
      <data key="d0">Palabrita</data>
      <data key="d1">organization</data>
      <data key="d2">Palabrita is a production Android word-guessing game that integrated on-device Small Language Models.</data>
      <data key="d3">chunk-2e7f40d6904acbb399d316edbe0a123b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142034</data>
      <data key="d6" />
    </node>
    <node id="Small Language Models (SLMs)">
      <data key="d0">Small Language Models (SLMs)</data>
      <data key="d1">model</data>
      <data key="d2">Small Language Models are AI models designed for fully offline, private experiences in mobile applications.&lt;SEP&gt;SLMs are smaller and more efficient language models that execute the full reasoning process under guidance from LLMs.&lt;SEP&gt;We leverage small language models as the main executor of prompt disambiguation to benefit from their efficient computation.</data>
      <data key="d3">chunk-2e7f40d6904acbb399d316edbe0a123b&lt;SEP&gt;chunk-8e25ff1edb5ddc4b28badb0143ccde17&lt;SEP&gt;chunk-b0733197acf40fb64366f709d6d6f836</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779187038</data>
      <data key="d6" />
    </node>
    <node id="On-Device SLM Integration Challenges">
      <data key="d0">On-Device SLM Integration Challenges</data>
      <data key="d1">category</data>
      <data key="d2">The challenges of integrating Small Language Models on-device include output format violations, constraint violations, context quality degradation, latency incompatibility, and model selection instability.</data>
      <data key="d3">chunk-2e7f40d6904acbb399d316edbe0a123b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142038</data>
      <data key="d6" />
    </node>
    <node id="Meta-CoT">
      <data key="d0">Meta-CoT</data>
      <data key="d1">method</data>
      <data key="d2">Meta-CoT is a paradigm that enhances granularity and generalization in image editing by decomposing editing tasks into three elements: task, target, and required understanding ability.</data>
      <data key="d3">chunk-2643db96ff06ade733f1ed549959310e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142204</data>
      <data key="d6" />
    </node>
    <node id="Chain-of-Thought (CoT)">
      <data key="d0">Chain-of-Thought (CoT)</data>
      <data key="d1">concept</data>
      <data key="d2">Chain-of-Thought (CoT) is a process used in unified multi-modal understanding/generative models to improve image editing performance.&lt;SEP&gt;Chain-of-thought refers to the intermediate reasoning process in a model's decision-making.&lt;SEP&gt;Chain-of-Thought (CoT) prompting elicits step-by-step solutions from large language models (LLMs).</data>
      <data key="d3">chunk-2643db96ff06ade733f1ed549959310e&lt;SEP&gt;chunk-efb47cac146c7b2f3ef3d164ff921698&lt;SEP&gt;chunk-e65899f92452776d1e2d8e56956888d2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779186774</data>
      <data key="d6" />
    </node>
    <node id="Unified Multi-Modal Understanding/Generative Models">
      <data key="d0">Unified Multi-Modal Understanding/Generative Models</data>
      <data key="d1">method</data>
      <data key="d2">These models incorporate fine-grained understanding into their CoT process, improving image editing performance.</data>
      <data key="d3">chunk-2643db96ff06ade733f1ed549959310e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142211</data>
      <data key="d6" />
    </node>
    <node id="Image Editing">
      <data key="d0">Image Editing</data>
      <data key="d1">task</data>
      <data key="d2">Image editing is the task of modifying images to achieve a specific goal or effect.</data>
      <data key="d3">chunk-2643db96ff06ade733f1ed549959310e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142211</data>
      <data key="d6" />
    </node>
    <node id="Editing Intention">
      <data key="d0">Editing Intention</data>
      <data key="d1">concept</data>
      <data key="d2">Editing intention refers to the purpose or goal behind an image editing operation.</data>
      <data key="d3">chunk-2643db96ff06ade733f1ed549959310e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142215</data>
      <data key="d6" />
    </node>
    <node id="Task-Specific CoT">
      <data key="d0">Task-Specific CoT</data>
      <data key="d1">method</data>
      <data key="d2">Meta-CoT generates task-specific CoT, which enhances the model's understanding granularity of editing operations.</data>
      <data key="d3">chunk-2643db96ff06ade733f1ed549959310e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142215</data>

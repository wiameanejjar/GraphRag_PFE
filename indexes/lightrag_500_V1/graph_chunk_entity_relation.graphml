    <node id="Coverage Envelope">
      <data key="d0">Coverage Envelope</data>
      <data key="d1">concept</data>
      <data key="d2">The Coverage Envelope comprises proven state, declared assumptions, and an acknowledged unobservable residual in the Reconstructive Authority Model.</data>
      <data key="d3">chunk-c76cc454c5e1f693609cbf2d13755e39</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779199850</data>
      <data key="d6" />

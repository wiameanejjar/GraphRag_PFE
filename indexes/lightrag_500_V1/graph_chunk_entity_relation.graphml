    <node id="\textsc{MATLAB/Simulink Simscape Fluids}">
      <data key="d0">\textsc{MATLAB/Simulink Simscape Fluids}</data>
      <data key="d1">software</data>
      <data key="d2">\textsc{MATLAB/Simulink Simscape Fluids} is a software used for modelling and simulating complex systems, including the main-fuel-pump system in aeroplanes.</data>
      <data key="d3">chunk-e3f60708b637794f8e8313ea63c450a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779211917</data>
      <data key="d6" />
    </node>
    <node id="Recurrent Variational Autoencoder (RNN-VAE)">
      <data key="d0">Recurrent Variational Autoencoder (RNN-VAE)</data>
      <data key="d1">method</data>
      <data key="d2">The Recurrent Variational Autoencoder (RNN-VAE) is an unsupervised machine learning model used for anomaly detection and diagnosis in cyber-physical systems.</data>
      <data key="d3">chunk-e3f60708b637794f8e8313ea63c450a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779211917</data>
      <data key="d6" />
    </node>
    <node id="SOM-VAE">
      <data key="d0">SOM-VAE</data>
      <data key="d1">method</data>
      <data key="d2">The SOM-VAE is a type of machine learning model that uses self-organizing maps (SOMs) and variational autoencoders (VAEs) to discretize operating modes in cyber-physical systems.</data>
      <data key="d3">chunk-e3f60708b637794f8e8313ea63c450a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779211921</data>
      <data key="d6" />
    </node>

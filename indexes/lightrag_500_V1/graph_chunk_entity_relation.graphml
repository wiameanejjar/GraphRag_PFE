    <node id="Windowed Neural Architectures">
      <data key="d0">Windowed Neural Architectures</data>
      <data key="d1">method</data>
      <data key="d2">Windowed neural architectures are a type of neural model that use context windows to predict the next activity.</data>
      <data key="d3">chunk-02d9ec7d187174eea2463881c8062a3a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779219935</data>

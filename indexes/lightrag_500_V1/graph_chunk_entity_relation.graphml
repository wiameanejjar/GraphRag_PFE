      <data key="d4">unknown_source</data>
      <data key="d5">1779165493</data>
      <data key="d6" />
    </node>
    <node id="Cyber-Physical Systems">
      <data key="d0">Cyber-Physical Systems</data>
      <data key="d1">concept</data>
      <data key="d2">Cyber-Physical Systems are integrated systems that combine physical and computational components, requiring a holistic approach to security threat modeling.&lt;SEP&gt;Cyber-physical systems are critical applications that integrate physical and computational components, such as aeroplanes.</data>
      <data key="d3">chunk-5231c468f16196e5461187bfc432c51b&lt;SEP&gt;chunk-e3f60708b637794f8e8313ea63c450a5</data>

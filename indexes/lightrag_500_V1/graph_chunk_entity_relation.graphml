      <data key="d0">LLaVA, InstructBLIP, InternVL, and Qwen-VL</data>
      <data key="d1">model</data>
      <data key="d2">PND generalizes effectively across diverse VLM architectures including LLaVA, InstructBLIP, InternVL, and Qwen-VL.</data>
      <data key="d3">chunk-0b83f3702bd088008cc6feaedfe42bcc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149008</data>

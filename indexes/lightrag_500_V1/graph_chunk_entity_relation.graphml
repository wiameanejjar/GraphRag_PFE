      <data key="d0">Agent-Type Value Forks</data>
      <data key="d1">concept</data>
      <data key="d2">Agent-Type Value Forks refer to the idea that people do not always hold AI systems to the same moral standards as humans.</data>
      <data key="d3">chunk-bbf5cdde0215fa8979b16920619610f2</data>
      <data key="d4">unknown_source</data>

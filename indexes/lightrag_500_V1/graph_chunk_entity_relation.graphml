    <node id="Efficient Logic Gate Networks">
      <data key="d0">Efficient Logic Gate Networks</data>
      <data key="d1">concept</data>
      <data key="d2">Efficient Logic Gate Networks is a framework proposed for video copy detection, combining aggressive frame miniaturization, binary preprocessing, and a trainable LGN embedding model.</data>
      <data key="d3">chunk-baaa108812ca4e7943f0f7559bc8aec0</data>
      <data key="d4">unknown_source</data>

    </edge>
    <edge source="Gradient Modification" target="Adaptive Decoupled Moment Routing">
      <data key="d7">1.0</data>
      <data key="d8">Adaptive decoupled moment routing was found to consistently avoid collapse across methods, optimizers, and scale, improving over vanilla by 3.8 units in the tested regime.</data>
      <data key="d9">method comparison,performance improvement</data>
      <data key="d10">chunk-350265fa6cfa6c36f900b8cfb64b92be</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1779202144</data>

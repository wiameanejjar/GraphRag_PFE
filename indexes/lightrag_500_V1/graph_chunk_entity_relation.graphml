    </node>
    <node id="Diffusion Language Models">
      <data key="d0">Diffusion Language Models</data>
      <data key="d1">method</data>
      <data key="d2">Diffusion language models generate without a fixed left-to-right order, making token ordering a central algorithmic choice.</data>

    <node id="NIST 800-53 Security Controls">
      <data key="d0">NIST 800-53 Security Controls</data>
      <data key="d1">category</data>
      <data key="d2">NIST 800-53 security controls are a set of guidelines and recommendations for securing information systems, used by SMSI to prioritize security threats.</data>

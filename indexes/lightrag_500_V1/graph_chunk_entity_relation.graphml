    </node>
    <node id="Dynamic Design Planner">
      <data key="d0">Dynamic Design Planner</data>
      <data key="d1">component</data>
      <data key="d2">The Dynamic Design Planner is a key innovation of RefEvo that autonomously decomposes design specifications and constructs tailored execution workflows based on semantic complexity.</data>
      <data key="d3">chunk-721cf18e9625b5e00d46286185f339e9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779153036</data>
      <data key="d6" />
    </node>
    <node id="Co-Evolutionary Verification Mechanism">
      <data key="d0">Co-Evolutionary Verification Mechanism</data>
      <data key="d1">component</data>
      <data key="d2">The Co-Evolutionary Verification Mechanism employs a Dialectical Arbiter to simultaneously rectify the model and verification logic against the specification oracle, mitigating false positives.</data>
      <data key="d3">chunk-721cf18e9625b5e00d46286185f339e9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779153040</data>
      <data key="d6" />
    </node>
    <node id="Spec Anchoring Strategy">

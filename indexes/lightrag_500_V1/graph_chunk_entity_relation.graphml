    <node id="Distillation Attacks">
      <data key="d0">Distillation Attacks</data>
      <data key="d1">method</data>
      <data key="d2">Distillation attacks involve bypassing a model's guardrails and misappropriating its capabilities through adversarial means.</data>
      <data key="d3">chunk-f0a260fdd44522539c1799dc8fb6c8a3</data>
      <data key="d4">unknown_source</data>

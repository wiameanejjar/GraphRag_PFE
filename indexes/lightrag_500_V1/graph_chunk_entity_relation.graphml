    <node id="Human Learners">
      <data key="d0">Human Learners</data>
      <data key="d1">person</data>
      <data key="d2">Human learners are able to accomplish transfer after minimal exposure and can induce latent structures through sequential exploration and transferring them across contexts.</data>
      <data key="d3">chunk-9c498a8ef8a91dd7345a0bc0c56faeed</data>
      <data key="d4">unknown_source</data>

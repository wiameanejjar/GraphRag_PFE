      <data key="d1">dataset</data>
      <data key="d2">The TREC Deep Learning dataset is used for evaluating ResRank's effectiveness in ranking tasks.</data>
      <data key="d3">chunk-35d6e4ada5453c7cde973c876f445327</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206802</data>
      <data key="d6" />
    </node>

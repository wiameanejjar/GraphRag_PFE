    <node id="The Alignment Target Problem">
      <data key="d0">The Alignment Target Problem</data>
      <data key="d1">concept</data>
      <data key="d2">The Alignment Target Problem refers to the divergence of moral standards applied to humans, AI systems, and their designers.</data>
      <data key="d3">chunk-bbf5cdde0215fa8979b16920619610f2</data>
      <data key="d4">unknown_source</data>

      <data key="d4">unknown_source</data>
      <data key="d5">1779203186</data>
      <data key="d6" />
    </node>
    <node id="Disaster Monitoring">
      <data key="d0">Disaster Monitoring</data>
      <data key="d1">task</data>
      <data key="d2">Disaster monitoring involves precise damage quantification, region-specific descriptions, and holistic post-disaster summaries.</data>

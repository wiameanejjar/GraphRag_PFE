      <data key="d0">Ideological Bias in LLMs' Economic Causal Reasoning</data>
      <data key="d1">concept</data>
      <data key="d2">The study investigates whether large language models exhibit systematic ideological bias when reasoning about economic causal effects.</data>
      <data key="d3">chunk-a83603d60645957cf376cc8d4c3dc750</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779227695</data>
      <data key="d6" />
    </node>

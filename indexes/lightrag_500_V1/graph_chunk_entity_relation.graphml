      <data key="d1">method</data>
      <data key="d2">Strategy Articulation turns mutation into a diagnose-direct-implement process using explicit natural language strategy descriptions.</data>
      <data key="d3">chunk-40da9bd6834b701e84e700fdf93b5c3c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149570</data>

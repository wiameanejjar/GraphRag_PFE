      <data key="d0">Risk Taxonomy</data>
      <data key="d1">dataset</data>
      <data key="d2">The Risk Taxonomy is a categorization of 7 categories, decomposed into 20 subcategories, used in ESRRSim for evaluating strategic reasoning risks.</data>
      <data key="d3">chunk-e8778c4326e5372d8016fc296ebdc67e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779208160</data>
      <data key="d6" />
    </node>

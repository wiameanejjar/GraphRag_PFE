      <data key="d0">Person Re-Identification</data>
      <data key="d1">task</data>
      <data key="d2">Person re-identification is a task that involves identifying individuals across different cameras or scenes.</data>
      <data key="d3">chunk-2a45bf678ca7078a36ca306ecefdd317</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206624</data>
      <data key="d6" />
    </node>
    <node id="Anchor Vectors">
      <data key="d0">Anchor Vectors</data>
      <data key="d1">concept</data>
      <data key="d2">Anchor vectors are used in SAGA-ReID to parameterize the text embedding space and align intermediate patch tokens.</data>
      <data key="d3">chunk-2a45bf678ca7078a36ca306ecefdd317</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206628</data>

    <node id="Para-Jailbreaking">
      <data key="d0">Para-Jailbreaking</data>
      <data key="d1">concept</data>
      <data key="d2">Para-jailbreaking is a class of model vulnerability where the model does not reveal harmful direct replies but still provides harmful information.</data>
      <data key="d3">chunk-db8ced0136efaaf767c85f4c9e185dbe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779157955</data>

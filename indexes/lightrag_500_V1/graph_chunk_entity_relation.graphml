    <node id="Personalized Worked Example Generation from Student Code Submissions using Pattern-based Knowledge Components">
      <data key="d0">Personalized Worked Example Generation from Student Code Submissions using Pattern-based Knowledge Components</data>
      <data key="d1">concept</data>
      <data key="d2">The approach focuses on generating personalized worked examples based on student code submissions and pattern-based knowledge components.</data>
      <data key="d3">chunk-421873c316a2a72fa1ccf5068ebdfe92</data>
      <data key="d4">unknown_source</data>

      <data key="d12">1779201610</data>
      <data key="d13" />
    </edge>
    <edge source="L2C" target="Cluster Reduction Theorem">
      <data key="d7">1.0</data>
      <data key="d8">L2C applies the Cluster Reduction Theorem to reduce any cluster to at most three nodes without loss of causal information, ensuring computational efficiency.</data>
      <data key="d9">computational efficiency,method application</data>
      <data key="d10">chunk-f1a24029d326af9c339a12a60c5c2246</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1779201614</data>
      <data key="d13" />
    </edge>
    <edge source="L2C" target="Local Causal Patterns">
      <data key="d7">1.0</data>
      <data key="d8">L2C discovers the partition automatically from local causal patterns.</data>
      <data key="d9">automatic,partition discovery</data>

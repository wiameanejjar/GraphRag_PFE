    <node id="FETS Benchmark">
      <data key="d0">FETS Benchmark</data>
      <data key="d1">dataset</data>
      <data key="d2">The FETS Benchmark is a collection of datasets used to evaluate the performance of foundation models in energy time series forecasting.</data>

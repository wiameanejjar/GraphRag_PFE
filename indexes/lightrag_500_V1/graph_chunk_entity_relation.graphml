      <data key="d1">dataset</data>
      <data key="d2">KEGG-informed pathway modules are used in PathMoG for reorganizing genome-scale inputs into 354 pathway modules.</data>
      <data key="d3">chunk-a78592bca66f2cefa305ee606ed12b84</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149757</data>

    </node>
    <node id="SWA">
      <data key="d0">SWA</data>
      <data key="d1">method</data>
      <data key="d2">SWA (local attention) is a technique that interleaves with KV Cache friendly architecture but may involve trade-offs between KV Cache and long-context modeling effectiveness.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779148250</data>

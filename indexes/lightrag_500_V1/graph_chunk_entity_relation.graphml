      <data key="d6" />
    </node>
    <node id="CAP-CoT">
      <data key="d0">CAP-CoT</data>
      <data key="d1">dataset</data>
      <data key="d2">CAP-CoT is a Cycle Adversarial Prompt framework designed to improve Chain of Thoughts in LLM Reasoning.</data>
      <data key="d3">chunk-e65899f92452776d1e2d8e56956888d2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779186774</data>
      <data key="d6" />

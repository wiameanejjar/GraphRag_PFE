    <node id="LLM-guided Evolutionary Search">
      <data key="d0">LLM-guided Evolutionary Search</data>
      <data key="d1">method</data>
      <data key="d2">LLM-guided evolutionary search is an automated algorithm discovery paradigm that uses natural-language reflection to track search progress.</data>
      <data key="d3">chunk-40da9bd6834b701e84e700fdf93b5c3c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149563</data>

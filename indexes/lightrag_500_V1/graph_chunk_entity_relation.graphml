    <node id="ESIA">
      <data key="d0">ESIA</data>
      <data key="d1">dataset</data>
      <data key="d2">ESIA is an energy-based spatiotemporal interaction-aware framework for pedestrian intention prediction.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171706</data>
      <data key="d6" />
    </node>
    <node id="Pedestrian Intention Prediction">
      <data key="d0">Pedestrian Intention Prediction</data>
      <data key="d1">task</data>
      <data key="d2">Pedestrian Intention Prediction aims to infer future crossing decisions and actions by modeling temporal dynamics, social interactions, and environmental context.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171706</data>
      <data key="d6" />
    </node>
    <node id="Conditional Random Field (CRF)">
      <data key="d0">Conditional Random Field (CRF)</data>
      <data key="d1">method</data>
      <data key="d2">ESIA uses a Conditional Random Field-based paradigm for structured prediction over a unified graph-based representation.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171713</data>
      <data key="d6" />
    </node>
    <node id="Unified Graph-Based Representation">
      <data key="d0">Unified Graph-Based Representation</data>
      <data key="d1">concept</data>
      <data key="d2">The framework treats pedestrians and the environment as spatiotemporal nodes in a unified graph-based representation.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171717</data>
      <data key="d6" />
    </node>
    <node id="Unary Potentials">
      <data key="d0">Unary Potentials</data>
      <data key="d1">method</data>
      <data key="d2">Unary potentials are assigned to nodes to capture individual intentions of pedestrians and environmental factors.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171717</data>
      <data key="d6" />
    </node>
    <node id="Pairwise Potentials">
      <data key="d0">Pairwise Potentials</data>
      <data key="d1">method</data>
      <data key="d2">Pairwise potentials are used to encode social and environmental interactions between pedestrians and the environment.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171722</data>
      <data key="d6" />
    </node>
    <node id="Global Energy Function">
      <data key="d0">Global Energy Function</data>
      <data key="d1">concept</data>
      <data key="d2">The framework integrates unary and pairwise potentials into a unified global energy function for scene-level consistency across behavioral predictions.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171722</data>
      <data key="d6" />
    </node>
    <node id="Unary-Seeded Simulated Annealing (U-SSA) Algorithm">
      <data key="d0">Unary-Seeded Simulated Annealing (U-SSA) Algorithm</data>
      <data key="d1">method</data>
      <data key="d2">ESIA uses a novel Unary-Seeded Simulated Annealing algorithm to efficiently solve the optimization problem without ground-truth supervision.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171726</data>
      <data key="d6" />
    </node>
    <node id="VIBES">
      <data key="d0">VIBES</data>
      <data key="d1">method</data>
      <data key="d2">VIBES is an asynchronous collaborative framework utilizing VLMs guided by Bayesian inference for efficient far-field anomaly detection in expressway surveillance videos.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171864</data>
      <data key="d6" />
    </node>
    <node id="VLM (Vision-Language Model)">
      <data key="d0">VLM (Vision-Language Model)</data>
      <data key="d1">model</data>
      <data key="d2">VLM demonstrates strong semantic reasoning capabilities but causes attention dilution when processing global frames.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171864</data>
      <data key="d6" />
    </node>
    <node id="Bayesian Inference Module">
      <data key="d0">Bayesian Inference Module</data>
      <data key="d1">method</data>
      <data key="d2">The Bayesian inference module continuously evaluates vehicle trajectories to dynamically update the probabilistic boundaries of normal driving behaviors.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171871</data>
      <data key="d6" />
    </node>
    <node id="Expressway Video Anomaly Detection">
      <data key="d0">Expressway Video Anomaly Detection</data>
      <data key="d1">task</data>
      <data key="d2">Expressway video anomaly detection is essential for safety management, particularly identifying anomalies across diverse scenes and far-field targets exhibiting subtle abnormal vehicle motions.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171871</data>
      <data key="d6" />
    </node>
    <node id="Far-Field Targets">
      <data key="d0">Far-Field Targets</data>
      <data key="d1">concept</data>
      <data key="d2">Far-field targets are objects located at a distance from the camera, requiring precise localization in space and time for accurate semantic reasoning.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171875</data>
      <data key="d6" />
    </node>
    <node id="Vehicle Trajectories">
      <data key="d0">Vehicle Trajectories</data>
      <data key="d1">dataset</data>
      <data key="d2">Vehicle trajectories are used to dynamically update the probabilistic boundaries of normal driving behaviors through Bayesian inference.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779171875</data>
      <data key="d6" />
    </node>
    <node id="AIPsy-Affect">
      <data key="d0">AIPsy-Affect</data>
      <data key="d1">dataset</data>
      <data key="d2">AIPsy-Affect is a clinical stimulus battery for mechanistic interpretability of emotion in language models, containing 480 keyword-free vignettes and neutral controls.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779172063</data>
      <data key="d6" />
    </node>
    <node id="Plutchik's Eight Primary Emotions">
      <data key="d0">Plutchik's Eight Primary Emotions</data>
      <data key="d1">concept</data>
      <data key="d2">Plutchik's eight primary emotions are the focus of AIPsy-Affect, including anger, fear, joy, trust, disgust, surprise, anticipation, and sadness.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779172063</data>
      <data key="d6" />
    </node>
    <node id="Activation Patching">
      <data key="d0">Activation Patching</data>
      <data key="d1">method</data>
      <data key="d2">Activation patching is another method used for analyzing emotion in language models, which involves modifying the model's activation patterns.&lt;SEP&gt;Activation patching involves transferring token-level hidden states from a CoT generation to a direct-answer run for the same question, then measuring the effect on final-answer accuracy.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f&lt;SEP&gt;chunk-efb47cac146c7b2f3ef3d164ff921698</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779184232</data>
      <data key="d6" />
    </node>
    <node id="Sparse Autoencoder (SAE) Feature Analysis">
      <data key="d0">Sparse Autoencoder (SAE) Feature Analysis</data>
      <data key="d1">method</data>
      <data key="d2">SAE feature analysis is a technique used to analyze the features of language models and understand how they represent emotions.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779172074</data>
      <data key="d6" />
    </node>
    <node id="Causal Ablation">
      <data key="d0">Causal Ablation</data>
      <data key="d1">method</data>
      <data key="d2">Causal ablation involves removing or modifying specific components of the model to understand their contribution to emotion representation.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779172074</data>
      <data key="d6" />
    </node>
    <node id="Steering Vector Extraction">
      <data key="d0">Steering Vector Extraction</data>
      <data key="d1">method</data>
      <data key="d2">Steering vector extraction is a method used to analyze how language models steer towards certain emotions or concepts.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779172079</data>
      <data key="d6" />
    </node>
    <node id="Bag-of-Words Sentiment">
      <data key="d0">Bag-of-Words Sentiment</data>
      <data key="d1">method</data>
      <data key="d2">Bag-of-words sentiment analysis involves analyzing the sentiment of text based on word frequencies, which can be used to detect affect in AIPsy-Affect.</data>
      <data key="d3">chunk-c4363ef0c05fc77ebccd829da2a9148f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779172079</data>
      <data key="d6" />
    </node>

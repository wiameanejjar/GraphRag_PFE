    <node id="Survey Data">
      <data key="d0">Survey Data</data>
      <data key="d1">dataset</data>
      <data key="d2">Survey data were collected from 546 university students as part of this study.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217796</data>
      <data key="d6" />
    </node>
    <node id="Semi-structured Interviews">
      <data key="d0">Semi-structured Interviews</data>
      <data key="d1">method</data>
      <data key="d2">Semi-structured interviews with 22 students were conducted to further interpret the quantitative findings.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217796</data>
      <data key="d6" />
    </node>
    <node id="Psychological Safety">
      <data key="d0">Psychological Safety</data>
      <data key="d1">concept</data>
      <data key="d2">Psychological safety is a key factor in increasing students' willingness to disclose AI use, according to this study's results.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217800</data>
      <data key="d6" />
    </node>
    <node id="Perceived Fairness">
      <data key="d0">Perceived Fairness</data>
      <data key="d1">metric</data>
      <data key="d2">Perceived fairness positively shapes psychological safety and disclosure intention, as indicated by the study's findings.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217800</data>
      <data key="d6" />
    </node>
    <node id="Teacher Support">
      <data key="d0">Teacher Support</data>
      <data key="d1">concept</data>
      <data key="d2">Teacher support is an important factor in promoting psychological safety and encouraging students to disclose AI use.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217804</data>

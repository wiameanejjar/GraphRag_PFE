    <node id="ChangeQuery Architecture">
      <data key="d0">ChangeQuery Architecture</data>
      <data key="d1">model</data>
      <data key="d2">The ChangeQuery architecture operates as an interactive disaster analyst, supporting multi-task reasoning driven by diverse user queries.</data>

    </node>
    <node id="Entropy">
      <data key="d0">Entropy</data>
      <data key="d1">metric</data>
      <data key="d2">Entropy is used as a measure of external uncertainty in the framework, capturing how disorder affects model behavior.&lt;SEP&gt;Entropy drives decision-tree splits in artificial intelligence.</data>
      <data key="d3">chunk-ddabb643ad7982794978859b96daf403&lt;SEP&gt;chunk-419980957d82676dc71009bd7f0dba3b</data>

    <node id="Cognition--Affect--Conation (CAC) Framework">
      <data key="d0">Cognition--Affect--Conation (CAC) Framework</data>
      <data key="d1">method</data>
      <data key="d2">The CAC framework is used to investigate the psychological mechanisms underlying university students' willingness to disclose AI use.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217792</data>

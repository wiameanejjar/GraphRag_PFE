      <data key="d4">unknown_source</data>
      <data key="d5">1779224066</data>
      <data key="d6" />
    </node>
    <node id="Decision Trajectories">
      <data key="d0">Decision Trajectories</data>
      <data key="d1">concept</data>
      <data key="d2">DP-RL systematically alters decision trajectories in task-dependent ways, promoting temporally structured behavior that cannot be explained by generic smoothing.</data>

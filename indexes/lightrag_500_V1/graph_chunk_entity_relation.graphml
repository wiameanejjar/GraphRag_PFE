    <node id="Attributes">
      <data key="d0">Attributes</data>
      <data key="d1">concept</data>
      <data key="d2">Attributes in energy forecasting refer to the characteristics of data used for prediction, including temporal, spatial, and attribute-based attributes.</data>
      <data key="d3">chunk-ce1c37c5b36081e4b5e6571b03199e12</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779203372</data>
      <data key="d6" />
    </node>
    <node id="Data Categories">
      <data key="d0">Data Categories</data>
      <data key="d1">concept</data>
      <data key="d2">Data categories in energy forecasting include typical stakeholder interests, such as load forecasting, price forecasting, and renewable energy forecasting.</data>
      <data key="d3">chunk-ce1c37c5b36081e4b5e6571b03199e12</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779203377</data>

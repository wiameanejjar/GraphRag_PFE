      <data key="d0">GraphRAG</data>
      <data key="d1">method</data>
      <data key="d2">GraphRAG extends traditional RAG by using knowledge graphs to give large language models a structured, semantically coherent context.</data>
      <data key="d3">chunk-64fad5be7471e063c4b5aa89695241f8</data>
      <data key="d4">unknown_source</data>

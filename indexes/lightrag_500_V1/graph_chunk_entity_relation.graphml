    </node>
    <node id="Landauer Principle">
      <data key="d0">Landauer Principle</data>
      <data key="d1">principle</data>
      <data key="d2">The Landauer Principle is a principle used to ground the Kerimov-Alekberli framework in physical work and entropic information.</data>
      <data key="d3">chunk-d10488f697007297062eb31177c84c90</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779157757</data>

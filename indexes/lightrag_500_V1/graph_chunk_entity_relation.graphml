      <data key="d0">Negative Log-Likelihood (NLL)</data>
      <data key="d1">metric</data>
      <data key="d2">Negative log-likelihood is a proxy for memorization used in prior work to evaluate the relationship between model performance degradation and NLL.</data>
      <data key="d3">chunk-d0165fe04be31ce6f032cb41873f78f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779220933</data>
      <data key="d6" />
    </node>
    <node id="Separable Expert Architecture">
      <data key="d0">Separable Expert Architecture</data>
      <data key="d1">concept</data>
      <data key="d2">The Separable Expert Architecture is a three-layer architecture that decouples personal data from shared weights in LLMs.</data>
      <data key="d3">chunk-184b06132a164bab8c574e36f309705f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779221085</data>
      <data key="d6" />
    </node>
    <node id="Phi-3.5-mini">
      <data key="d0">Phi-3.5-mini</data>
      <data key="d1">dataset</data>
      <data key="d2">Phi-3.5-mini is a dataset used for evaluating the Separable Expert Architecture's performance on per-user differentiation.</data>
      <data key="d3">chunk-184b06132a164bab8c574e36f309705f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779221085</data>
      <data key="d6" />
    </node>
    <node id="Composable Domain-Expert LoRA Adapters">
      <data key="d0">Composable Domain-Expert LoRA Adapters</data>
      <data key="d1">method</data>
      <data key="d2">Composable Domain-Expert LoRA Adapters are used to shape behavior without imparting user data in the Separable Expert Architecture.</data>
      <data key="d3">chunk-184b06132a164bab8c574e36f309705f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779221092</data>
      <data key="d6" />
    </node>
    <node id="Deletable User Proxies">
      <data key="d0">Deletable User Proxies</data>
      <data key="d1">concept</data>
      <data key="d2">Deletable User Proxies are artefacts that can be deleted, leading to deterministic unlearning in the Separable Expert Architecture.</data>
      <data key="d3">chunk-184b06132a164bab8c574e36f309705f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779221096</data>
      <data key="d6" />
    </node>
    <node id="Differentially Private Stochastic Gradient Descent (DP-SGD)">
      <data key="d0">Differentially Private Stochastic Gradient Descent (DP-SGD)</data>
      <data key="d1">method</data>
      <data key="d2">Differentially Private Stochastic Gradient Descent (DP-SGD) is a method used for privacy-preserving shared model improvement that is compatible with the Separable Expert Architecture.</data>
      <data key="d3">chunk-184b06132a164bab8c574e36f309705f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779221096</data>

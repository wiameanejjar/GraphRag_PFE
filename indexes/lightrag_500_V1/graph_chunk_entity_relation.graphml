    <node id="Model Predictive Control">
      <data key="d0">Model Predictive Control</data>
      <data key="d1">method</data>
      <data key="d2">Model Predictive Control is a method for controlling hybrid dynamical systems by predicting future behavior and adjusting inputs accordingly.</data>
      <data key="d3">chunk-014b8ae28e95cbf89d881af21e70a6b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212509</data>

    <node id="Generative Synthetic Data">
      <data key="d0">Generative Synthetic Data</data>
      <data key="d1">concept</data>
      <data key="d2">Generative Synthetic Data is a promising tool for privacy-preserving data release, augmentation, and simulation in causal inference.</data>
      <data key="d3">chunk-755055e56a32b2634be9cdc8f1d609c2</data>
      <data key="d4">unknown_source</data>

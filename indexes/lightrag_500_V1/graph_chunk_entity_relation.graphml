      <data key="d1">task</data>
      <data key="d2">Video copy detection is a task requiring robust similarity estimation under diverse visual distortions while operating at very large scale.</data>
      <data key="d3">chunk-baaa108812ca4e7943f0f7559bc8aec0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779218516</data>

    </node>
    <node id="Stigma">
      <data key="d0">Stigma</data>
      <data key="d1">concept</data>
      <data key="d2">Perceived stigma is a factor that strengthens evaluation apprehension and negatively impacts disclosure intention and psychological safety.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>

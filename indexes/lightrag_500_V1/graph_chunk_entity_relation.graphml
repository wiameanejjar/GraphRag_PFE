      <data key="d1">metric</data>
      <data key="d2">This reward encourages more accurate and effective utilization of CoT information during image editing.</data>
      <data key="d3">chunk-2643db96ff06ade733f1ed549959310e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779142220</data>
      <data key="d6" />
    </node>

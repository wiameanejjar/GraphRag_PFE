    <node id="Public Datasets">
      <data key="d0">Public Datasets</data>
      <data key="d1">dataset</data>
      <data key="d2">MTServe is evaluated on public datasets, achieving significant speedup and high hit ratios.</data>
      <data key="d3">chunk-3dc81f5a7528411e1220bc62eebacde1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206478</data>
      <data key="d6" />
    </node>
    <node id="Production Datasets">
      <data key="d0">Production Datasets</data>
      <data key="d1">dataset</data>
      <data key="d2">MTServe also delivers impressive results on production datasets, maintaining near-perfect hit ratios.</data>
      <data key="d3">chunk-3dc81f5a7528411e1220bc62eebacde1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206478</data>
      <data key="d6" />
    </node>
    <node id="CLIP Feature Aggregation">
      <data key="d0">CLIP Feature Aggregation</data>
      <data key="d1">concept</data>
      <data key="d2">CLIP Feature Aggregation is an approach used in person re-identification methods, which aggregates spatial features into a single global token.</data>
      <data key="d3">chunk-2a45bf678ca7078a36ca306ecefdd317</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206617</data>

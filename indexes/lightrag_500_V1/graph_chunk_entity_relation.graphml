    <node id="AsyncShield">
      <data key="d0">AsyncShield</data>
      <data key="d1">method</data>
      <data key="d2">AsyncShield is a plug-and-play edge adapter for asynchronous cloud-based VLA navigation that addresses network jitter and inference latency issues.</data>
      <data key="d3">chunk-047ce2bc252a55d9055c31539d3a7c47</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779157506</data>

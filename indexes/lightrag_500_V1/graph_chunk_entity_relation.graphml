    </node>
    <node id="Structural Equation Modelling">
      <data key="d0">Structural Equation Modelling</data>
      <data key="d1">method</data>
      <data key="d2">Structural equation modelling was employed in the quantitative phase of this study to examine relationships among cognitive perceptions, affective responses, and disclosure intention.</data>
      <data key="d3">chunk-f41be395492fbaac3392c09ecad51d45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779217792</data>

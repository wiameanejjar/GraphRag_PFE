      <data key="d0">Linear Relaxation Techniques</data>
      <data key="d1">method</data>
      <data key="d2">Linear relaxation techniques are improved upon by Super-DeepG for robustness certification.</data>
      <data key="d3">chunk-c00a185631f5831f02808b92381af986</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779149353</data>
      <data key="d6" />
    </node>

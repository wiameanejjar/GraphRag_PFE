    </node>
    <node id="PhantomEcosystem">
      <data key="d0">PhantomEcosystem</data>
      <data key="d1">dataset</data>
      <data key="d2">PhantomEcosystem is a comprehensive benchmark comprising 9 categories of realistic cross-agent violation scenarios with adversarially balanced safe controls.</data>
      <data key="d3">chunk-71069a5345037996a5ed3ee296df014f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779206949</data>
      <data key="d6" />
    </node>
    <node id="Distributed Sentinel Architecture">
      <data key="d0">Distributed Sentinel Architecture</data>
      <data key="d1">method</data>
      <data key="d2">The Distributed Sentinel Architecture introduces lightweight sidecar proxies for security state propagation and Counterfactual Graph Simulation for cross-domain policy verification.</data>

      <data key="d4">unknown_source</data>
      <data key="d5">1779165698</data>
      <data key="d6" />
    </node>
    <node id="Hybrid Synthetic-Data Framework">
      <data key="d0">Hybrid Synthetic-Data Framework</data>
      <data key="d1">method</data>
      <data key="d2">The Hybrid Synthetic-Data Framework generates covariates separately from the treatment and outcome mechanisms, using distance-to-closest-record diagnostics to monitor covariate synthesis and separately learned nuisance models to construct (W, A, Y) triplets.</data>
      <data key="d3">chunk-755055e56a32b2634be9cdc8f1d609c2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779165702</data>
      <data key="d6" />
    </node>
    <node id="Targeted Synthetic Augmentation">
      <data key="d0">Targeted Synthetic Augmentation</data>
      <data key="d1">method</data>
      <data key="d2">Targeted Synthetic Augmentation is used for practical positivity problems and characterizes when added overlap support helps by improving conditional-effect estimation more than it shifts the covariate distribution.</data>
      <data key="d3">chunk-755055e56a32b2634be9cdc8f1d609c2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779165702</data>

    <node id="Neural Architecture Search">
      <data key="d0">Neural Architecture Search</data>
      <data key="d1">method</data>
      <data key="d2">Neural Architecture Search is a technique used to design deep networks for edge accelerators, guided by device-level metrics.</data>

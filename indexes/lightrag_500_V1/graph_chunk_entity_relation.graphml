    <node id="Hybrid Dynamical Systems">
      <data key="d0">Hybrid Dynamical Systems</data>
      <data key="d1">concept</data>
      <data key="d2">Hybrid Dynamical Systems are complex systems that combine continuous and discrete dynamics, requiring control strategies that account for both aspects.</data>
      <data key="d3">chunk-014b8ae28e95cbf89d881af21e70a6b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212509</data>
      <data key="d6" />
    </node>
    <node id="Model Predictive Control of Hybrid Dynamical Systems">
      <data key="d0">Model Predictive Control of Hybrid Dynamical Systems</data>
      <data key="d1">dataset</data>
      <data key="d2">The dataset consists of hybrid dynamical systems controlled using Model Predictive Control, with sufficient conditions for asymptotic stability provided.</data>
      <data key="d3">chunk-014b8ae28e95cbf89d881af21e70a6b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212515</data>

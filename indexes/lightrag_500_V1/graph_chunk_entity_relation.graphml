    </node>
    <node id="Abstract Puzzles">
      <data key="d0">Abstract Puzzles</data>
      <data key="d1">concept</data>
      <data key="d2">Abstract puzzles are used as probing tasks to evaluate autoregressive and diffusion-based models in terms of both pixel-wise fidelity and logical validity.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779212102</data>
      <data key="d6" />
    </node>
    <node id="Autoregressive Models">
      <data key="d0">Autoregressive Models</data>
      <data key="d1">method</data>
      <data key="d2">Autoregressive models are evaluated using abstract puzzles in AMAZE.</data>

    <node id="Amaze">
      <data key="d0">Amaze</data>
      <data key="d1">dataset</data>
      <data key="d2">AMAZE is a procedurally generated dataset featuring the classical Maze and Queen problems, covering distinct forms of visual planning.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">2604.22868v1</data>
      <data key="d5">1780426369</data>

    <node id="Qaecter">
      <data key="d0">Qaecter</data>
      <data key="d1">model</data>
      <data key="d2">QaECTER is a 344M-parameter embedding model trained on patent citation graphs and multi-view self-alignment, achieving state-of-the-art results in patent retrieval.</data>
      <data key="d3">chunk-4ff858f01baeea77bbe235bf5c5bbced</data>

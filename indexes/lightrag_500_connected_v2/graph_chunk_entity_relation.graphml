      <data key="d4">2604.23179v1</data>
      <data key="d5">1780356868</data>
      <data key="d6" />
    </node>
    <node id="Variable Numbers Of Humans">
      <data key="d0">Variable Numbers Of Humans</data>
      <data key="d1">concept</data>
      <data key="d2">Variable Numbers of Humans refers to the ability of the proposed framework to handle different numbers of observed humans in indoor environments.</data>
      <data key="d3">chunk-e3c7bf6aa95dbbb47a5109f81b1a609e</data>
      <data key="d4">2604.23179v1</data>
      <data key="d5">1780356872</data>
      <data key="d6" />
    </node>
    <node id="Facility Management">
      <data key="d0">Facility Management</data>
      <data key="d1">application</data>
      <data key="d2">Facility management is an application of monitoring human activity in indoor environments.</data>

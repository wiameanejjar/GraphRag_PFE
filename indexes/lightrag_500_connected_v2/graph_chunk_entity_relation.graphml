    <edge source="Algorithmic Approaches" target="Fair Machine Learning">
      <data key="d7">1.0</data>
      <data key="d8">Fair machine learning methods help identify and mitigate the risk that algorithms encode or automate social injustices by supporting socio-technical decision systems.</data>
      <data key="d9">fairness support,socio-technical decision systems</data>
      <data key="d10">chunk-fe7fc82733330af762752cd6e70c474d</data>

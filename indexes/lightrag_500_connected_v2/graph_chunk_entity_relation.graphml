    <node id="Empowerment">
      <data key="d0">Empowerment</data>
      <data key="d1">metric</data>
      <data key="d2">Empowerment is an operational metric that measures the channel capacity between actions and anticipated observations, distinguishing zero-, intermediate-, and high-agency phenotypes.</data>
      <data key="d3">chunk-7283e187a29957165bf39353160ea1b0</data>
      <data key="d4">2604.23278v1</data>
      <data key="d5">1780350094</data>

    </edge>
    <edge source="Marvel" target="Visual Modality Collapse">
      <data key="d7">1.0</data>
      <data key="d8">Marvel exhibits visual modality collapse, where it disregards visual features while depending excessively on textual cues.</data>
      <data key="d9">challenge,model issue</data>

    <edge source="AI Hiring Applications" target="Supply Chain Dependencies">
      <data key="d7">1.0</data>
      <data key="d8">Modern AI hiring systems operate within complex supply chain dependencies where responsibility fragments across various stakeholders, contributing to the emergence of bias.</data>
      <data key="d9">bias emergence,system complexity</data>
      <data key="d10">chunk-8a9bb4320aa0f6b0b69b9c0e565dafeb</data>

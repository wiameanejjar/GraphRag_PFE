    <node id="Asymmetric Contradiction-Penalised Weighted Groundedness Score">
      <data key="d0">Asymmetric Contradiction-Penalised Weighted Groundedness Score</data>
      <data key="d1">concept</data>
      <data key="d2">The asymmetric contradiction-penalised weighted groundedness score is a metric used in GSAR to evaluate the groundedness of claims and evidence, taking into account the strength and relevance of evidence.</data>
      <data key="d3">chunk-d0377df6ea4a3c4d53fdf21fda1a230f</data>
      <data key="d4">2604.23366v1</data>
      <data key="d5">1780344994</data>

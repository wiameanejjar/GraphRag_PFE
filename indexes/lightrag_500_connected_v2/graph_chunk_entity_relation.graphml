    <node id="Monet">
      <data key="d0">Monet</data>
      <data key="d1">model</data>
      <data key="d2">MONET is a multi-task optimization algorithm that models the task space as a graph, enabling knowledge transfer between tasks and exploiting the topology of the task space.</data>
      <data key="d3">chunk-b50eb193d4b7beed74fdee062999a545</data>
      <data key="d4">2604.21991v1</data>
      <data key="d5">1780427030</data>

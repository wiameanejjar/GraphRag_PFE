    <node id="Individual Learning">
      <data key="d0">Individual Learning</data>
      <data key="d1">method</data>
      <data key="d2">Individual learning refines a node's own solution independently via mutation in MONET's multi-task optimization algorithm.</data>
      <data key="d3">chunk-b50eb193d4b7beed74fdee062999a545</data>
      <data key="d4">2604.21991v1</data>

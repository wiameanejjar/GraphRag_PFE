    <node id="Green Shielding">
      <data key="d0">Green Shielding</data>
      <data key="d1">concept</data>
      <data key="d2">Green Shielding is a user-centric approach for building evidence-backed deployment guidance by characterizing how benign input variation shifts model behavior.</data>
      <data key="d3">chunk-2df46a60ce12797a8d4e5b624970ede7</data>

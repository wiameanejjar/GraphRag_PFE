    </edge>
    <edge source="Active Inference" target="Variational Framework">
      <data key="d7">1.0</data>
      <data key="d8">Active Inference instantiates the criteria of intentionality, rationality, and explainability as an agentic action chain within the variational framework.</data>
      <data key="d9">agentic action chain,method relationship</data>

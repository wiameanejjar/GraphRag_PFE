    <node id="Video Question Answering (Videoqa)">
      <data key="d0">Video Question Answering (Videoqa)</data>
      <data key="d1">task</data>
      <data key="d2">VideoQA involves models that jointly reason over spatial, temporal, and linguistic cues for accurate task completion.</data>
      <data key="d3">chunk-6b568d5411e28f68d9c3dec659627695</data>
      <data key="d4">2604.23145v1</data>
      <data key="d5">1780358214</data>
      <data key="d6" />
    </node>
    <node id="AR-LLM Social Engineering Attack">
      <data key="d0">AR-LLM Social Engineering Attack</data>
      <data key="d1">concept</data>
      <data key="d2">An AR-LLM Social Engineering attack involves using AR glass to capture the target's image and vocal information, identifying the target with an LLM, generating a social profile, applying social engineering strategies for conversation suggestion, and performing phishing.</data>
      <data key="d3">chunk-48a4a658e93da7ba77d376aa7954dd6c</data>
      <data key="d4">2604.23141v1</data>
      <data key="d5">1780358625</data>
      <data key="d6" />
    </node>
    <node id="Ar (Augmented Reality) Glass">
      <data key="d0">Ar (Augmented Reality) Glass</data>
      <data key="d1">tool</data>
      <data key="d2">AR glass is used by attackers in AR-LLM Social Engineering attacks to capture the target's image and vocal information.</data>
      <data key="d3">chunk-48a4a658e93da7ba77d376aa7954dd6c</data>
      <data key="d4">2604.23141v1</data>
      <data key="d5">1780358625</data>
      <data key="d6" />
    </node>

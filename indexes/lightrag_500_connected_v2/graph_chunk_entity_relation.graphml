      <data key="d0">Counterfactual Imagining</data>
      <data key="d1">concept</data>
      <data key="d2">Counterfactual imagining is a method used in DeepImagine to approximate hidden causal mechanisms of clinical trials by training models to infer how observed trial results would change under controlled perturbations of experimental conditions.</data>
      <data key="d3">chunk-aa2fe98eb0332bb5266e58ce1e38a485</data>
      <data key="d4">2604.23054v1</data>
      <data key="d5">1780365214</data>

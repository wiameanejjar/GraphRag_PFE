      <data key="d1">concept</data>
      <data key="d2">Spatio-temporal identity drift is a challenge underlying the failures of Vision-Language Models in dynamic real-world scenarios.</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">2604.24443v1</data>
      <data key="d5">1780273516</data>

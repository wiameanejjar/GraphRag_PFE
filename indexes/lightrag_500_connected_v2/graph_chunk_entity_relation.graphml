      <data key="d6" />
    </node>
    <node id="Discrete Cosine Transform (Dct)">
      <data key="d0">Discrete Cosine Transform (Dct)</data>
      <data key="d1">method</data>
      <data key="d2">The Discrete Cosine Transform is a mathematical technique used to reduce correlations among network inputs in time series forecasting tasks.</data>
      <data key="d3">chunk-e23e98ddd4e5fe85f00b42dfe531c002</data>
      <data key="d4">2604.23518v1</data>
      <data key="d5">1780333607</data>
      <data key="d6" />
    </node>
    <node id="Kolmogorov-Arnold Networks (Kans)">
      <data key="d0">Kolmogorov-Arnold Networks (Kans)</data>
      <data key="d1">model</data>
      <data key="d2">Kolmogorov-Arnold Networks are a type of neural network that can potentially overcome spectral bias in certain conditions.</data>
      <data key="d3">chunk-e23e98ddd4e5fe85f00b42dfe531c002</data>
      <data key="d4">2604.23518v1</data>
      <data key="d5">1780333607</data>
      <data key="d6" />
    </node>
    <node id="Spectral Bias">
      <data key="d0">Spectral Bias</data>
      <data key="d1">concept</data>
      <data key="d2">Spectral bias refers to the tendency of neural networks to favor certain frequencies over others, often leading to suboptimal performance in tasks like time series forecasting.</data>
      <data key="d3">chunk-e23e98ddd4e5fe85f00b42dfe531c002</data>

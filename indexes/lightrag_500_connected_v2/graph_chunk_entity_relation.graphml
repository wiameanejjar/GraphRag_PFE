    <node id="AI Identity">
      <data key="d0">AI Identity</data>
      <data key="d1">concept</data>
      <data key="d2">AI Identity refers to the continuous relationship between an AI agent's declared identity and its observed behavior, bounded by confidence in their correspondence.</data>

      <data key="d11">2604.21326v1</data>
      <data key="d12">1780458437</data>
      <data key="d13" />
    </edge>
    <edge source="Semantic Misalignment" target="Univl-Dr">
      <data key="d7">1.0</data>
      <data key="d8">Although UniVL-DR is less affected by visual modality collapse, it is more susceptible to semantic misalignment, where semantically related content is positioned far apart in the embedding space.</data>

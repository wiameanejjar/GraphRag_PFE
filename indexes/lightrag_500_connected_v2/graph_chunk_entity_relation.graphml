      <data key="d0">Client-Side Training Load</data>
      <data key="d1">concept</data>
      <data key="d2">Client-side training load refers to the computational cost of client-side model updates.</data>
      <data key="d3">chunk-7b76b69fbc52715fc463c5d181400ff4</data>
      <data key="d4">2604.23386v1</data>
      <data key="d5">1780343601</data>

    <node id="Permafrost">
      <data key="d0">Permafrost</data>
      <data key="d1">concept</data>
      <data key="d2">PermaFrost is a threat to future foundation models, analogous to Arctic permafrost, where harmful material remains frozen and unnoticed for long periods before resurfacing when conditions allow.</data>
      <data key="d3">chunk-8084488ac0f355725aa1f5bce383f709</data>
      <data key="d4">2604.22117v1</data>
      <data key="d5">1780397969</data>

    </node>
    <node id="Internal Faults">
      <data key="d0">Internal Faults</data>
      <data key="d1">concept</data>
      <data key="d2">Internal faults refer to physical inconsistencies in current trajectories that can trigger protection mechanisms.</data>
      <data key="d3">chunk-764120ed432e664023feb791fa299941</data>
      <data key="d4">2604.23666v1</data>
      <data key="d5">1780324169</data>

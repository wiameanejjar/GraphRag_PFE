    <edge source="Deployment-Aligned Low-Precision Training" target="Vessel Segmentation">
      <data key="d7">1.0</data>
      <data key="d8">Deployment-aligned low-precision training achieves better performance on vessel segmentation compared to post-training precision conversion.</data>

    <node id="Dxchain">
      <data key="d0">Dxchain</data>
      <data key="d1">model</data>
      <data key="d2">DxChain is a novel chain-based clinical reasoning framework that transforms the diagnostic workflow into an iterative process by mirroring a clinician's cognitive trajectory.</data>

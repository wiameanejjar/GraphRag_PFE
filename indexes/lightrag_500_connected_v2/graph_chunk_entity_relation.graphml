    </node>
    <node id="Open-Source Editing Models">
      <data key="d0">Open-Source Editing Models</data>
      <data key="d1">application</data>
      <data key="d2">Open-source editing models also struggle in zero-shot settings but improve with finetuning on basic scales.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">2604.22868v1</data>
      <data key="d5">1780426380</data>
      <data key="d6" />
    </node>
    <node id="Proprietary Editing Models">
      <data key="d0">Proprietary Editing Models</data>
      <data key="d1">application</data>
      <data key="d2">Proprietary editing models struggle in zero-shot settings but show remarkable generalization with finetuning on basic scales.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">2604.22868v1</data>
      <data key="d5">1780426380</data>

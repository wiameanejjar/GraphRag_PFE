    <edge source="Goal Drift Detection" target="Intent Lineage Tracking (Ilt)">
      <data key="d7">1.0</data>
      <data key="d8">Goal Drift Detection and Intent Lineage Tracking (ILT) are methods that contribute to maintaining goal integrity in AI systems by tracking executable intents and detecting semantically divergent intents.</data>
      <data key="d9">method comparison,system transparency</data>
      <data key="d10">chunk-7e96add2029229f6380f800cfe0896c3</data>
      <data key="d11">2604.23646v1</data>

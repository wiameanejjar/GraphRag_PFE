    <node id="Permafrost-Attack">
      <data key="d0">Permafrost-Attack</data>
      <data key="d1">concept</data>
      <data key="d2">PermaFrost-Attack is a stealth pretraining seeding attack family that embeds dormant logic landmines during LLM training, which can be activated by precise alphanumeric triggers.</data>
      <data key="d3">chunk-8084488ac0f355725aa1f5bce383f709</data>
      <data key="d4">2604.22117v1</data>
      <data key="d5">1780397973</data>

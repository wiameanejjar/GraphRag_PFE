    </node>
    <node id="Human Solvers">
      <data key="d0">Human Solvers</data>
      <data key="d1">concept</data>
      <data key="d2">Human solvers are more efficient than neural visual reasoning models in solving visual planning tasks.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">2604.22868v1</data>
      <data key="d5">1780426376</data>
      <data key="d6" />
    </node>
    <node id="Image Editing Models">
      <data key="d0">Image Editing Models</data>
      <data key="d1">application</data>
      <data key="d2">Image editing models are used to tackle the inherently visual problem of visual planning through verbal-centric approaches.</data>
      <data key="d3">chunk-a37d8bc68fa184d22dbb48cdba94e9ed</data>
      <data key="d4">2604.22868v1</data>
      <data key="d5">1780426376</data>

    </edge>
    <edge source="Aleatoric Uncertainty" target="Annotator Disagreement">
      <data key="d7">2.0</data>
      <data key="d8">Aleatoric uncertainty is estimated via a dedicated ambiguity output trained to match annotator disagreement when available in CREDENCE.&lt;SEP&gt;Aleatoric uncertainty closely tracks annotator disagreement.</data>
      <data key="d9">ambiguity-estimation,tracking,training,uncertainty-decomposition</data>
      <data key="d10">chunk-186325b8d21aab395207850cb3577223</data>

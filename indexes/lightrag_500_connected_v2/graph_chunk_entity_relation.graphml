    <node id="Shapleycov Measure">
      <data key="d0">Shapleycov Measure</data>
      <data key="d1">metric</data>
      <data key="d2">ShapleyCov is a measure that calculates the expected number of items isolated by a contributor's departure, based on the Shapley value.</data>
      <data key="d3">chunk-07c4e7a4f2a8090be70ffa68d5ac787e</data>
      <data key="d4">2604.21537v1</data>

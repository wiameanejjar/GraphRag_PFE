      <data key="d1">method</data>
      <data key="d2">Social learning generates candidates from neighboring nodes via crossover in MONET's multi-task optimization algorithm.</data>
      <data key="d3">chunk-b50eb193d4b7beed74fdee062999a545</data>
      <data key="d4">2604.21991v1</data>
      <data key="d5">1780427030</data>

    <node id="Block Gibbs Sampling">
      <data key="d0">Block Gibbs Sampling</data>
      <data key="d1">method</data>
      <data key="d2">A hardware-accelerated inference algorithm based on parallelized block Gibbs sampling is developed to recover stable particle motion and groupings.</data>

    <node id="Fever">
      <data key="d0">Fever</data>
      <data key="d1">dataset</data>
      <data key="d2">FEVER is a dataset used for evaluating the performance of grounding-evaluation frameworks like GSAR, consisting of text passages with labeled claims and evidence.</data>
      <data key="d3">chunk-d0377df6ea4a3c4d53fdf21fda1a230f</data>

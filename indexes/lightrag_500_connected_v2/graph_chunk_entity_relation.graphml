    <node id="Causal Attention">
      <data key="d0">Causal Attention</data>
      <data key="d1">concept</data>
      <data key="d2">Causal attention is a mechanism in VAR that fails to fully exploit global low-quality (LQ) context, resulting in blurry and inconsistent high-quality (HQ) outputs.</data>
      <data key="d3">chunk-33747e9b7fdcb18f70889d195b652453</data>
      <data key="d4">2604.21450v1</data>

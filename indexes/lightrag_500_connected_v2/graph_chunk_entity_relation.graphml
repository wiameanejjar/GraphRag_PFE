    <node id="Computer Vision Systems">
      <data key="d0">Computer Vision Systems</data>
      <data key="d1">application</data>
      <data key="d2">Existing computer vision systems lack a unified approach that works across diverse settings, such as sparse moving dots, textured surfaces, or naturalistic scenes.</data>
      <data key="d3">chunk-a796b36576b3a3580d3e19194a2554bd</data>
      <data key="d4">2604.22160v1</data>
      <data key="d5">1780396121</data>
      <data key="d6" />
    </node>
    <node id="Genmatter">
      <data key="d0">Genmatter</data>
      <data key="d1">model</data>
      <data key="d2">GenMatter is a generative model that hierarchically groups low-level motion cues and high-level appearance features into particles, enabling robust object-level scene understanding.</data>
      <data key="d3">chunk-a796b36576b3a3580d3e19194a2554bd</data>
      <data key="d4">2604.22160v1</data>
      <data key="d5">1780396128</data>

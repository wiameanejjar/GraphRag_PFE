    <node id="Energy-Based Spatiotemporal Interaction-Aware Framework">
      <data key="d0">Energy-Based Spatiotemporal Interaction-Aware Framework</data>
      <data key="d1">concept</data>
      <data key="d2">The Energy-Based Spatiotemporal Interaction-Aware Framework is a novel paradigm for pedestrian intention prediction that models temporal dynamics, social interactions, and environmental context.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318048</data>
      <data key="d6" />
    </node>
    <node id="Environmental Context">
      <data key="d0">Environmental Context</data>
      <data key="d1">concept</data>
      <data key="d2">Environmental Context refers to the surroundings that affect pedestrian behavior.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318054</data>
      <data key="d6" />
    </node>
    <node id="Esia">
      <data key="d0">Esia</data>
      <data key="d1">model</data>
      <data key="d2">ESIA is an energy-based spatiotemporal interaction-aware framework for pedestrian intention prediction, proposed in this work.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318054</data>
      <data key="d6" />
    </node>
    <node id="Global Energy Function">
      <data key="d0">Global Energy Function</data>
      <data key="d1">concept</data>
      <data key="d2">The Global Energy Function is a unified function that integrates unary and pairwise potentials to ensure scene-level consistency across behavioral predictions.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318059</data>
      <data key="d6" />
    </node>
    <node id="Pairwise Potentials">
      <data key="d0">Pairwise Potentials</data>
      <data key="d1">method</data>
      <data key="d2">Pairwise Potentials are used in ESIA to encode social and environmental interactions between pedestrians and their environment.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318059</data>
      <data key="d6" />
    </node>
    <node id="Pedestrian Intention Prediction Task">
      <data key="d0">Pedestrian Intention Prediction Task</data>
      <data key="d1">task</data>
      <data key="d2">The Pedestrian Intention Prediction Task aims to infer future crossing decisions and actions by modeling temporal dynamics, social interactions, and environmental context.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318063</data>
      <data key="d6" />
    </node>
    <node id="Social Interactions">
      <data key="d0">Social Interactions</data>
      <data key="d1">concept</data>
      <data key="d2">Social Interactions refer to the interactions between pedestrians and their environment.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318063</data>
      <data key="d6" />
    </node>
    <node id="Temporal Dynamics">
      <data key="d0">Temporal Dynamics</data>
      <data key="d1">concept</data>
      <data key="d2">Temporal Dynamics refer to the changes in pedestrian behavior over time.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318067</data>
      <data key="d6" />
    </node>
    <node id="Unary Potentials">
      <data key="d0">Unary Potentials</data>
      <data key="d1">method</data>
      <data key="d2">Unary Potentials are used in ESIA to capture individual intentions of pedestrians and environmental nodes.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318067</data>
      <data key="d6" />
    </node>
    <node id="Unary-Seeded Simulated Annealing (U-Ssa) Algorithm">
      <data key="d0">Unary-Seeded Simulated Annealing (U-Ssa) Algorithm</data>
      <data key="d1">method</data>
      <data key="d2">The Unary-Seeded Simulated Annealing algorithm is used in ESIA to efficiently solve the optimization problem without ground-truth supervision.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318072</data>
      <data key="d6" />
    </node>
    <node id="Unified Graph-Based Representation">
      <data key="d0">Unified Graph-Based Representation</data>
      <data key="d1">concept</data>
      <data key="d2">The Unified Graph-Based Representation is a structured prediction problem that treats pedestrians and the environment as spatiotemporal nodes.</data>
      <data key="d3">chunk-708326382d0ab7f10b01675bd6eea542</data>
      <data key="d4">2604.23728v1</data>
      <data key="d5">1780318072</data>
      <data key="d6" />
    </node>
    <node id="Bayesian Inference Module">
      <data key="d0">Bayesian Inference Module</data>
      <data key="d1">method</data>
      <data key="d2">The Bayesian inference module continuously evaluates vehicle trajectories to dynamically update the probabilistic boundaries of normal driving behaviors, serving as an asynchronous trigger for anomaly localization.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">2604.23724v1</data>
      <data key="d5">1780318319</data>
      <data key="d6" />
    </node>
    <node id="Expressway Environments">
      <data key="d0">Expressway Environments</data>
      <data key="d1">concept</data>
      <data key="d2">Expressway environments vary, making it challenging to generalize across different conditions.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">2604.23724v1</data>
      <data key="d5">1780318319</data>
      <data key="d6" />
    </node>
    <node id="Expressway Video Anomaly Detection">
      <data key="d0">Expressway Video Anomaly Detection</data>
      <data key="d1">task</data>
      <data key="d2">Expressway video anomaly detection is essential for safety management and involves identifying anomalies across diverse scenes.</data>
      <data key="d3">chunk-26dafa661cb0d231f43ed8c9672433fe</data>
      <data key="d4">2604.23724v1</data>
      <data key="d5">1780318326</data>

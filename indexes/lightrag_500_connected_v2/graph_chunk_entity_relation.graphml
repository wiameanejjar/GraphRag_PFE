    <node id="Verified Knowledge">
      <data key="d0">Verified Knowledge</data>
      <data key="d1">concept</data>
      <data key="d2">Verified knowledge is the result of PhysNote's iterative reasoning loop and consolidation process.</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">2604.24443v1</data>
      <data key="d5">1780273520</data>
      <data key="d6" />
    </node>
    <node id="Visual Evidence">
      <data key="d0">Visual Evidence</data>
      <data key="d1">concept</data>
      <data key="d2">Visual evidence is used by PhysNote to ground hypotheses and consolidate verified knowledge.</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">2604.24443v1</data>
      <data key="d5">1780273525</data>
      <data key="d6" />
    </node>
    <node id="Visual Perception">
      <data key="d0">Visual Perception</data>
      <data key="d1">concept</data>
      <data key="d2">Visual perception is an important aspect of PhysNote's performance on PhysBench.</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">2604.24443v1</data>
      <data key="d5">1780273525</data>
      <data key="d6" />
    </node>
    <node id="Volatility Of Inference-Time Insights">
      <data key="d0">Volatility Of Inference-Time Insights</data>
      <data key="d1">concept</data>
      <data key="d2">Volatility of inference-time insights is a challenge underlying the failures of Vision-Language Models in dynamic real-world scenarios.</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">2604.24443v1</data>
      <data key="d5">1780273529</data>
      <data key="d6" />
    </node>
    <node id="GQA">
      <data key="d0">GQA</data>
      <data key="d1">method</data>
      <data key="d2">GQA is a compression technique that reduces KV cache per layer through head-level compression.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273812</data>
      <data key="d6" />
    </node>
    <node id="Gdn">
      <data key="d0">Gdn</data>
      <data key="d1">method</data>
      <data key="d2">GDN is another linear kernel mechanism that involves trade-offs among KV Cache and long-context modeling effectiveness.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273812</data>
      <data key="d6" />
    </node>
    <node id="KV Cache">
      <data key="d0">KV Cache</data>
      <data key="d1">tool</data>
      <data key="d2">KV cache refers to the cache used in attention mechanisms for storing key and value vectors.&lt;SEP&gt;KV-Cache is a capability carrier that can be supported under the same abstraction as other heterogeneous carriers in the Diffusion Templates framework.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461&lt;SEP&gt;chunk-f36584a3c17d75781a357f1a3e17848d</data>
      <data key="d4">2604.24432v1&lt;SEP&gt;2604.24351v1</data>
      <data key="d5">1780277789</data>
      <data key="d6" />
    </node>
    <node id="Kwai Summary Attention">
      <data key="d0">Kwai Summary Attention</data>
      <data key="d1">model</data>
      <data key="d2">Kwai Summary Attention is a novel attention mechanism proposed to reduce sequence modeling costs in long-context settings.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273819</data>
      <data key="d6" />
    </node>
    <node id="MLA">
      <data key="d0">MLA</data>
      <data key="d1">method</data>
      <data key="d2">MLA is another compression technique that reduces KV cache dimension through embedding dimension-level compression.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273823</data>
      <data key="d6" />
    </node>
    <node id="Softmax Attention">
      <data key="d0">Softmax Attention</data>
      <data key="d1">method</data>
      <data key="d2">Softmax attention is a standard attention mechanism that exhibits quadratic time complexity with respect to sequence length.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273828</data>
      <data key="d6" />
    </node>
    <node id="Swa">
      <data key="d0">Swa</data>
      <data key="d1">method</data>
      <data key="d2">SWA is a local attention mechanism that interleaves with KV Cache friendly architecture.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273828</data>
      <data key="d6" />
    </node>
    <node id="Code Agentic Intelligence">
      <data key="d0">Code Agentic Intelligence</data>
      <data key="d1">concept</data>
      <data key="d2">Code agentic intelligence is a concept that involves using code as an agent to perform tasks, such as recommendation systems.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273832</data>
      <data key="d6" />
    </node>
    <node id="Semantic Understanding/Reasoning">
      <data key="d0">Semantic Understanding/Reasoning</data>
      <data key="d1">concept</data>
      <data key="d2">Semantic understanding/reasoning refers to the ability of models to comprehend and reason about complex semantic information.</data>
      <data key="d3">chunk-274e345107d112e4d4358391f4226461</data>
      <data key="d4">2604.24432v1</data>
      <data key="d5">1780273832</data>
      <data key="d6" />
    </node>
    <node id="Bandroutenet">
      <data key="d0">Bandroutenet</data>
      <data key="d1">model</data>
      <data key="d2">BandRouteNet is an adaptive band routing neural network designed for EEG artifact removal, jointly exploiting band-specific processing and full-band contextual modeling.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274172</data>
      <data key="d6" />
    </node>
    <node id="Eegdenoisenet Benchmark Dataset">
      <data key="d0">Eegdenoisenet Benchmark Dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">The EEGDenoiseNet benchmark dataset is used to evaluate the performance of BandRouteNet in removing EOG, EMG, and mixed-artifact conditions.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274172</data>
      <data key="d6" />
    </node>
    <node id="Electroencephalography (Eeg)">
      <data key="d0">Electroencephalography (Eeg)</data>
      <data key="d1">concept</data>
      <data key="d2">EEG is a highly susceptible signal to artifact contamination, including EOG and EMG interference, which severely degrades signal quality and hinders reliable interpretation in applications such as neurological diagnosis and brain-computer interfaces.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274179</data>
      <data key="d6" />
    </node>
    <node id="Electromyographic (Emg) Interference">
      <data key="d0">Electromyographic (Emg) Interference</data>
      <data key="d1">concept</data>
      <data key="d2">EMG is another type of artifact contamination affecting EEG signals, also showing diverse and temporally varying distributions with distinct spectral characteristics across frequency bands.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274179</data>
      <data key="d6" />
    </node>
    <node id="Electrooculographic (Eog) Interference">
      <data key="d0">Electrooculographic (Eog) Interference</data>
      <data key="d1">concept</data>
      <data key="d2">EOG is a type of artifact contamination that affects EEG signals, exhibiting diverse and temporally varying distributions with distinct spectral characteristics across frequency bands.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274183</data>
      <data key="d6" />
    </node>
    <node id="Relative Root Mean Square Error (Rrmse)">
      <data key="d0">Relative Root Mean Square Error (Rrmse)</data>
      <data key="d1">metric</data>
      <data key="d2">RRMSE is a metric used to evaluate the performance of EEG denoising methods, measuring the difference between the original and denoised signals.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274183</data>
      <data key="d6" />
    </node>
    <node id="Signal-To-Noise Ratio Improvement (Snr$_{Text{Imp}}$)">
      <data key="d0">Signal-To-Noise Ratio Improvement (Snr$_{Text{Imp}}$)</data>
      <data key="d1">metric</data>
      <data key="d2">SNR$_{\text{imp}}$ is another metric used to evaluate the performance of EEG denoising methods, measuring the improvement in signal quality after denoising.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274188</data>
      <data key="d6" />
    </node>
    <node id="Eeg Artifact Removal">
      <data key="d0">Eeg Artifact Removal</data>
      <data key="d1">task</data>
      <data key="d2">EEG artifact removal is a critical task in neuroscience and brain-computer interfaces, where BandRouteNet demonstrates strong potential.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274188</data>
      <data key="d6" />
    </node>
    <node id="Frequency Bands">
      <data key="d0">Frequency Bands</data>
      <data key="d1">concept</data>
      <data key="d2">Frequency bands are used in BandRouteNet to capture frequency-dependent artifact patterns and improve denoising performance.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274192</data>
      <data key="d6" />
    </node>
    <node id="Neural Network">
      <data key="d0">Neural Network</data>
      <data key="d1">model</data>
      <data key="d2">A neural network is a type of machine learning model used for various tasks, including EEG artifact removal.&lt;SEP&gt;A Neural Network is the architecture used in Fast Adversarial Training to enhance robustness against adversarial attacks.&lt;SEP&gt;A Neural Network is a type of machine learning model that can be verified using the proposed framework.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f&lt;SEP&gt;chunk-1275d6a1c7d7e5d54c4d93057e8775c3&lt;SEP&gt;chunk-17e3402c333a7100fbe7f64435a9853c</data>
      <data key="d4">2604.24428v1&lt;SEP&gt;2604.24350v1&lt;SEP&gt;2604.21556v1</data>
      <data key="d5">1780445361</data>
      <data key="d6" />
    </node>
    <node id="Resource-Constrained Applications">
      <data key="d0">Resource-Constrained Applications</data>
      <data key="d1">application</data>
      <data key="d2">BandRouteNet is highly parameter-efficient and suitable for resource-constrained applications such as EEG artifact removal in neurological diagnosis and brain-computer interfaces.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274196</data>
      <data key="d6" />
    </node>
    <node id="Unified Experimental Settings">
      <data key="d0">Unified Experimental Settings</data>
      <data key="d1">concept</data>
      <data key="d2">Unified experimental settings are used to compare the performance of different methods in EEG denoising.</data>
      <data key="d3">chunk-52b17af2fefc317fc473ae09097c0b2f</data>
      <data key="d4">2604.24428v1</data>
      <data key="d5">1780274196</data>
      <data key="d6" />
    </node>
    <node id="Continuous Diffusion (Cd) Slms">
      <data key="d0">Continuous Diffusion (Cd) Slms</data>
      <data key="d1">model</data>
      <data key="d2">CD SLMs are a type of model that uses continuous diffusion to process speech inputs, showing potential for improved performance over discrete autoregressive models.</data>
      <data key="d3">chunk-46ffaa95d62e06c5c32f7e8193bede58</data>
      <data key="d4">2604.24416v1</data>
      <data key="d5">1780275140</data>
      <data key="d6" />
    </node>
    <node id="Discrete Autoregressive (Ar) Slms">
      <data key="d0">Discrete Autoregressive (Ar) Slms</data>
      <data key="d1">model</data>
      <data key="d2">AR SLMs are a type of model that discretizes continuous speech for processing, but have significant computational and data demands.</data>
      <data key="d3">chunk-46ffaa95d62e06c5c32f7e8193bede58</data>
      <data key="d4">2604.24416v1</data>
      <data key="d5">1780275140</data>
      <data key="d6" />
    </node>
    <node id="Phoneme Jensen-Shannon Divergence (Pjsd) Metric">
      <data key="d0">Phoneme Jensen-Shannon Divergence (Pjsd) Metric</data>
      <data key="d1">metric</data>
      <data key="d2">The pJSD metric is used to quantify the linguistic quality of SLMs and has been introduced in this paper.</data>
      <data key="d3">chunk-46ffaa95d62e06c5c32f7e8193bede58</data>
      <data key="d4">2604.24416v1</data>
      <data key="d5">1780275146</data>
      <data key="d6" />
    </node>
    <node id="Scaling Properties Of Continuous Diffusion Spoken Language Models">
      <data key="d0">Scaling Properties Of Continuous Diffusion Spoken Language Models</data>
      <data key="d1">concept</data>
      <data key="d2">The paper discusses the scaling properties of continuous diffusion spoken language models and their potential for generating high-quality speech.</data>
      <data key="d3">chunk-46ffaa95d62e06c5c32f7e8193bede58</data>
      <data key="d4">2604.24416v1</data>
      <data key="d5">1780275146</data>
      <data key="d6" />
    </node>
    <node id="Speech-Only Spoken Language Models (Slms)">
      <data key="d0">Speech-Only Spoken Language Models (Slms)</data>
      <data key="d1">model</data>
      <data key="d2">SLMs are a type of model that process only speech inputs, lagging behind text and text-speech models in performance.</data>
      <data key="d3">chunk-46ffaa95d62e06c5c32f7e8193bede58</data>
      <data key="d4">2604.24416v1</data>
      <data key="d5">1780275151</data>
      <data key="d6" />
    </node>
    <node id="Text-Speech Models">
      <data key="d0">Text-Speech Models</data>
      <data key="d1">model</data>
      <data key="d2">Text-speech models process both text and speech inputs, outperforming speech-only models in many tasks.</data>
      <data key="d3">chunk-46ffaa95d62e06c5c32f7e8193bede58</data>
      <data key="d4">2604.24416v1</data>
      <data key="d5">1780275151</data>
      <data key="d6" />
    </node>
    <node id="Audio Reliance">
      <data key="d0">Audio Reliance</data>
      <data key="d1">concept</data>
      <data key="d2">Audio Reliance assesses actual dependency on the acoustic signal in audio-language evaluation.</data>
      <data key="d3">chunk-cd399b744aa24b4b8e4a44b747320f02</data>
      <data key="d4">2604.24401v1</data>
      <data key="d5">1780275358</data>
      <data key="d6" />
    </node>
    <node id="Diagnostic Framework">
      <data key="d0">Diagnostic Framework</data>
      <data key="d1">method</data>
      <data key="d2">The diagnostic framework uses two axes: text prior and audio reliance to evaluate Large Audio-Language Models.</data>
      <data key="d3">chunk-cd399b744aa24b4b8e4a44b747320f02</data>
      <data key="d4">2604.24401v1</data>
      <data key="d5">1780275358</data>
      <data key="d6" />
    </node>
    <node id="Lalms (Large Audio-Language Models)">
      <data key="d0">Lalms (Large Audio-Language Models)</data>
      <data key="d1">model</data>
      <data key="d2">LALMs are a type of AI model that show consistent performance gains across speech and audio benchmarks.</data>
      <data key="d3">chunk-cd399b744aa24b4b8e4a44b747320f02</data>
      <data key="d4">2604.24401v1</data>
      <data key="d5">1780275365</data>
      <data key="d6" />
    </node>
    <node id="Speech And Audio Benchmarks">
      <data key="d0">Speech And Audio Benchmarks</data>
      <data key="d1">benchmark</data>
      <data key="d2">Speech and Audio Benchmarks are evaluation metrics used to assess the performance of Large Audio-Language Models.</data>
      <data key="d3">chunk-cd399b744aa24b4b8e4a44b747320f02</data>
      <data key="d4">2604.24401v1</data>
      <data key="d5">1780275365</data>
      <data key="d6" />
    </node>
    <node id="Text Prior">
      <data key="d0">Text Prior</data>
      <data key="d1">concept</data>
      <data key="d2">Text Prior measures answerability from text and general knowledge alone, without processing the acoustic signal.</data>
      <data key="d3">chunk-cd399b744aa24b4b8e4a44b747320f02</data>
      <data key="d4">2604.24401v1</data>
      <data key="d5">1780275369</data>
      <data key="d6" />
    </node>
    <node id="Robust Audio Understanding">
      <data key="d0">Robust Audio Understanding</data>
      <data key="d1">concept</data>
      <data key="d2">Robust audio understanding is a key aspect of audio-language evaluation, which was challenged by the findings of the paper.</data>
      <data key="d3">chunk-cd399b744aa24b4b8e4a44b747320f02</data>
      <data key="d4">2604.24401v1</data>
      <data key="d5">1780275374</data>
      <data key="d6" />
    </node>
    <node id="Chair">
      <data key="d0">Chair</data>
      <data key="d1">benchmark</data>
      <data key="d2">CHAIR is a benchmark used to evaluate PND's performance.</data>
      <data key="d3">chunk-0b83f3702bd088008cc6feaedfe42bcc</data>
      <data key="d4">2604.24396v1</data>
      <data key="d5">1780275668</data>
      <data key="d6" />
    </node>
    <node id="Instructblip">
      <data key="d0">Instructblip</data>

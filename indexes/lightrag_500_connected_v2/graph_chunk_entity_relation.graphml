    <node id="Active Inference">
      <data key="d0">Active Inference</data>
      <data key="d1">method</data>
      <data key="d2">Active Inference is a method for characterizing agency in artificial intelligence systems by instantiating three criteria: intentionality, rationality, and explainability.</data>
      <data key="d3">chunk-7283e187a29957165bf39353160ea1b0</data>
      <data key="d4">2604.23278v1</data>

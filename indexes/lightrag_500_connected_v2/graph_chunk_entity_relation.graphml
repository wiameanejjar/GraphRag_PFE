    <node id="Evidential Trust Manipulation">
      <data key="d0">Evidential Trust Manipulation</data>
      <data key="d1">concept</data>
      <data key="d2">Evidential trust manipulation refers to the experimental manipulation of source trustworthiness to examine its impact on Turkish evidential morphology.</data>
      <data key="d3">chunk-c55766a45b0f180acb4d559b875dcdd9</data>
      <data key="d4">2604.24665v1</data>
      <data key="d5">1780259787</data>

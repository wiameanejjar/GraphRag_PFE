    </node>
    <node id="Server-Side Resolution Algorithm">
      <data key="d0">Server-Side Resolution Algorithm</data>
      <data key="d1">method</data>
      <data key="d2">A server-side resolution algorithm is proposed to handle client-level disagreements and ensure strict client exclusion.</data>
      <data key="d3">chunk-7b76b69fbc52715fc463c5d181400ff4</data>
      <data key="d4">2604.23386v1</data>
      <data key="d5">1780343622</data>
      <data key="d6" />
    </node>
    <node id="Strategic Control">
      <data key="d0">Strategic Control</data>
      <data key="d1">concept</data>
      <data key="d2">Strategic control is a critical consideration in Federated Learning, as clients may need to exclude one another for competitive reasons.</data>
      <data key="d3">chunk-7b76b69fbc52715fc463c5d181400ff4</data>
      <data key="d4">2604.23386v1</data>
      <data key="d5">1780343622</data>
      <data key="d6" />
    </node>
    <node id="Submodel Reuse Strategy">
      <data key="d0">Submodel Reuse Strategy</data>
      <data key="d1">method</data>
      <data key="d2">A submodel reuse strategy is proposed to mitigate the client-side training load from participating in multiple tracks.</data>
      <data key="d3">chunk-7b76b69fbc52715fc463c5d181400ff4</data>
      <data key="d4">2604.23386v1</data>
      <data key="d5">1780343627</data>
      <data key="d6" />
    </node>
    <node id="Temporal Disagreement Patterns">
      <data key="d0">Temporal Disagreement Patterns</data>
      <data key="d1">concept</data>
      <data key="d2">Temporal disagreement patterns refer to scenarios where clients temporarily exclude one another.</data>
      <data key="d3">chunk-7b76b69fbc52715fc463c5d181400ff4</data>
      <data key="d4">2604.23386v1</data>
      <data key="d5">1780343627</data>
      <data key="d6" />
    </node>
    <node id="Unconditional Collaboration">
      <data key="d0">Unconditional Collaboration</data>
      <data key="d1">concept</data>
      <data key="d2">Unconditional collaboration refers to the assumption that all clients will collaborate on model training.</data>
      <data key="d3">chunk-7b76b69fbc52715fc463c5d181400ff4</data>
      <data key="d4">2604.23386v1</data>
      <data key="d5">1780343631</data>

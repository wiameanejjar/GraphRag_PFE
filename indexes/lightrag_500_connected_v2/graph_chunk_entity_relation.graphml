      <data key="d0">Ar Acl (Access Control Layer)</data>
      <data key="d1">tool</data>
      <data key="d2">The AR ACL is part of UNSEEN, providing identity-gated sensing in the cross-stack defense.</data>
      <data key="d3">chunk-48a4a658e93da7ba77d376aa7954dd6c</data>
      <data key="d4">2604.23141v1</data>
      <data key="d5">1780358632</data>
      <data key="d6" />
    </node>

    <node id="Cognitive Discourse Theory">
      <data key="d0">Cognitive Discourse Theory</data>
      <data key="d1">theory</data>
      <data key="d2">Cognitive Discourse Theory provides a framework for understanding how language is used to convey meaning, which is applied in this work to probe, extract, and visualize latent LLM personas.</data>
      <data key="d3">chunk-090dd9c7587ef7f5e03426647d58470b</data>
      <data key="d4">2604.24079v1</data>

    <node id="Type 1 Diabetes (T1D)">
      <data key="d0">Type 1 Diabetes (T1D)</data>
      <data key="d1">condition</data>
      <data key="d2">T1D is an autoimmune disease where patients rely on exogenous insulin, leading to potential hypoglycemia risks due to medication dosing and physiological responses.</data>
      <data key="d3">chunk-f192dda64c5cc46c62ae9feadc822c82</data>

    <node id="S^2It">
      <data key="d0">S^2It</data>
      <data key="d1">model</data>
      <data key="d2">S^2IT is a novel Stepwise Syntax Integration Tuning framework that progressively integrates syntactic structure knowledge into Large Language Models.</data>
      <data key="d3">chunk-7460eba8c45931fa1d37a0c8e3e04c61</data>
      <data key="d4">2604.23296v1</data>

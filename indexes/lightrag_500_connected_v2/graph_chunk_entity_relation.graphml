    </edge>
    <edge source="Concept Bottleneck Models" target="Epistemic Uncertainty">
      <data key="d7">1.0</data>
      <data key="d8">Concept Bottleneck Models typically output point concept probabilities that conflate epistemic uncertainty with aleatoric uncertainty.</data>
      <data key="d9">conflation,model-uncertainty</data>

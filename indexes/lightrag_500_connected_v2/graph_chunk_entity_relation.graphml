    </edge>
    <edge source="Aleatoric Uncertainty" target="Epistemic Uncertainty">
      <data key="d7">1.0</data>
      <data key="d8">Epistemic uncertainty is positively associated with prediction errors, whereas aleatoric uncertainty closely tracks annotator disagreement.</data>
      <data key="d9">distinction,uncertainty-decomposition</data>
      <data key="d10">chunk-186325b8d21aab395207850cb3577223</data>
      <data key="d11">2604.24170v1</data>
      <data key="d12">1780287135</data>

    <node id="Disease Progression">
      <data key="d0">Disease Progression</data>
      <data key="d1">concept</data>
      <data key="d2">Disease progression varies with age due to genetic, biochemical, and hormonal etiologies, necessitating personalized approaches beyond standard clinical guidelines.</data>
      <data key="d3">chunk-f192dda64c5cc46c62ae9feadc822c82</data>
      <data key="d4">2604.23732v1</data>
      <data key="d5">1780317475</data>

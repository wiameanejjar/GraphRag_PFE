      <data key="d0">Hallucinations</data>
      <data key="d1">concept</data>
      <data key="d2">Hallucinations refer to outputs that are not grounded in the visual input, a common issue in LVLMs.</data>
      <data key="d3">chunk-d3ba0f324a606c4227526581aeedb047</data>
      <data key="d4">2604.21911v1</data>

    <node id="Recurrent Variational Autoencoder (RNN-VAE)">
      <data key="d0">Recurrent Variational Autoencoder (RNN-VAE)</data>
      <data key="d1">method</data>
      <data key="d2">The RNN-VAE is an unsupervised learning model that detects anomalies in the system by identifying unusual patterns in the data.</data>
      <data key="d3">chunk-e3f60708b637794f8e8313ea63c450a5</data>
      <data key="d4">2604.22869v1</data>
      <data key="d5">1780426185</data>

    <node id="Autonomous Driving Control System">
      <data key="d0">Autonomous Driving Control System</data>
      <data key="d1">application</data>
      <data key="d2">Our approach was applied to an autonomous driving control system, successfully resolving inconsistencies in an operational rule inferred by a conventional baseline while remaining grammar compliant.</data>
      <data key="d3">chunk-2d0cda25c660336dba17f393f96c07ce</data>
      <data key="d4">2604.23523v1</data>
      <data key="d5">1780333380</data>

    </node>
    <node id="Far-Field Targets">
      <data key="d0">Far-Field Targets</data>
      <data key="d1">concept</data>
      <data key="d2">Far-field targets exhibit subtle abnormal vehicle motions, making them challenging to detect in Expressway Surveillance Videos.</data>

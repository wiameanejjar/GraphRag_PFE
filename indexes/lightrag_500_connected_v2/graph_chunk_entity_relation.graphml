      <data key="d1">model</data>
      <data key="d2">DeepImagine is a framework for teaching large language models (LLMs) biomedical reasoning through successive counterfactual imagining.</data>
      <data key="d3">chunk-aa2fe98eb0332bb5266e58ce1e38a485</data>
      <data key="d4">2604.23054v1</data>
      <data key="d5">1780365221</data>

    <node id="Backdoor Attack">
      <data key="d0">Backdoor Attack</data>
      <data key="d1">concept</data>
      <data key="d2">A backdoor attack is a type of poisoning-based attack that embeds triggers in training data to cause models to misclassify triggered inputs as adversary-specified labels while maintaining performance on clean data.</data>
      <data key="d3">chunk-16e1942c6343c62dd06a2dcfcadbb982</data>
      <data key="d4">2604.21416v1</data>
      <data key="d5">1780451844</data>

      <data key="d0">Cognitive Appraisal Variables</data>
      <data key="d1">concept</data>
      <data key="d2">Cognitive Appraisal Variables are used in the proposed model to predict underlying appraisal variables and bridge the semantic gap between "positive emotions" and "pleasure."</data>
      <data key="d3">chunk-910c57075f353f24182e5f8e12e3d2a1</data>
      <data key="d4">2604.23753v1</data>
      <data key="d5">1780316339</data>

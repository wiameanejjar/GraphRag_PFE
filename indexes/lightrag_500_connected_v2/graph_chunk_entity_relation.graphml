      <data key="d0">Halluscope</data>
      <data key="d1">benchmark</data>
      <data key="d2">HalluScope is a benchmark designed to understand the factors inducing hallucinations in LVLMs, specifically focusing on textual priors and background knowledge.</data>
      <data key="d3">chunk-d3ba0f324a606c4227526581aeedb047</data>
      <data key="d4">2604.21911v1</data>
      <data key="d5">1780428272</data>

    <node id="Single-Block Universal Transformer (Ut)">
      <data key="d0">Single-Block Universal Transformer (Ut)</data>
      <data key="d1">model</data>
      <data key="d2">The Single-Block Universal Transformer is a type of transformer architecture that uses memory tokens for adaptive computation time.</data>

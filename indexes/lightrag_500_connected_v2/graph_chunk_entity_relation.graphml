    <node id="Hypoglycemia">
      <data key="d0">Hypoglycemia</data>
      <data key="d1">condition</data>
      <data key="d2">Hypoglycemia is a dangerous condition characterized by decreased blood glucose levels ($\leq$70), which can be mitigated through improved diabetes management supported by data analytics.</data>
      <data key="d3">chunk-f192dda64c5cc46c62ae9feadc822c82</data>
      <data key="d4">2604.23732v1</data>
      <data key="d5">1780317479</data>

    <node id="Self-Preference Bias">
      <data key="d0">Self-Preference Bias</data>
      <data key="d1">concept</data>
      <data key="d2">Self-Preference Bias is a directional evaluative deviation where LLMs favor or disfavor their own generated outputs during evaluation.</data>
      <data key="d3">chunk-879cb5db2211c2283dd060ddcd2850ac</data>
      <data key="d4">2604.22891v1</data>
      <data key="d5">1780384170</data>

    </node>
    <node id="Random Dot Kinematograms">
      <data key="d0">Random Dot Kinematograms</data>
      <data key="d1">dataset</data>
      <data key="d2">The model operates on 2D random dot kinematograms, enabling it to work across settings where biological vision succeeds but existing computer vision approaches do not.</data>
      <data key="d3">chunk-a796b36576b3a3580d3e19194a2554bd</data>
      <data key="d4">2604.22160v1</data>
      <data key="d5">1780396136</data>

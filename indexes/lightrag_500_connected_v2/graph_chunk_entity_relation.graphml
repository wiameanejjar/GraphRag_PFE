    </node>
    <node id="Safety Assessment">
      <data key="d0">Safety Assessment</data>
      <data key="d1">application</data>
      <data key="d2">Safety assessment is another application of monitoring human activity in indoor environments.</data>
      <data key="d3">chunk-e3c7bf6aa95dbbb47a5109f81b1a609e</data>
      <data key="d4">2604.23179v1</data>

    </edge>
    <edge source="Goal Drift Detection" target="Pea Architecture">
      <data key="d7">1.0</data>
      <data key="d8">Goal Drift Detection is part of the PEA architecture and rejects semantically divergent intents below a configurable threshold in AI systems.</data>
      <data key="d9">method implementation,system safety</data>

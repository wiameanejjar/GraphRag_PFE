      <data key="d0">Temporal Consistency</data>
      <data key="d1">concept</data>
      <data key="d2">Temporal consistency is an important aspect of PhysNote's performance on PhysBench.</data>
      <data key="d3">chunk-3fae825413dbd09250459cbd5bbfe30c</data>
      <data key="d4">2604.24443v1</data>
      <data key="d5">1780273516</data>

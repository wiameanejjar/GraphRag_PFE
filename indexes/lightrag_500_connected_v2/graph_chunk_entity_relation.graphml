    </edge>
    <edge source="Intent Verification Layer (Ivl)" target="Pea Architecture">
      <data key="d7">1.0</data>
      <data key="d8">The Intent Verification Layer (IVL) is part of the PEA architecture and ensures capability-intent consistency in AI systems.</data>
      <data key="d9">method implementation,system safety</data>
      <data key="d10">chunk-7e96add2029229f6380f800cfe0896c3</data>
      <data key="d11">2604.23646v1</data>

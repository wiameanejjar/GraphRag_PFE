    <node id="Bridging Inference">
      <data key="d0">Bridging Inference</data>
      <data key="d1">concept</data>
      <data key="d2">Bridging inference is a method that interprets LLM dialogue by identifying implicit conceptual relations connecting utterances via shared world knowledge and discourse coherence.</data>

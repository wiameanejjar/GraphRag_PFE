    <node id="Gsar">
      <data key="d0">Gsar</data>
      <data key="d1">model</data>
      <data key="d2">GSAR is a grounding-evaluation and replanning framework for multi-agent LLMs that partitions claims into a four-way typology, assigns evidence-type-specific weights, computes an asymmetric contradiction-penalised weighted groundedness score, and couples it to a three-tier decision function.</data>
      <data key="d3">chunk-d0377df6ea4a3c4d53fdf21fda1a230f</data>
      <data key="d4">2604.23366v1</data>
      <data key="d5">1780344985</data>

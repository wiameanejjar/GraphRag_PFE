    <edge source="L2 Simulator" target="World Model">
      <data key="d7">1.0</data>
      <data key="d8">An L2 Simulator is a type of world model that composes local transition operators into multi-step rollouts at the second-highest capability level.</data>
      <data key="d9">capability level,predictive model</data>
      <data key="d10">chunk-18e0c86d41c3bf130424dd4d09af51e2</data>

      <data key="d1">concept</data>
      <data key="d2">Constraint-Based Analysis of Reasoning Shortcuts in Neurosymbolic Learning is a concept that deals with the problem of reasoning shortcuts in neurosymbolic learning.</data>
      <data key="d3">chunk-8b661d44ac0479d8113583804dd72adc</data>
      <data key="d4">2604.23377v1</data>
      <data key="d5">1780344005</data>

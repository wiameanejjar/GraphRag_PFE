      <data key="d0">Learning-Free Multi-Robot Baseline</data>
      <data key="d1">method</data>
      <data key="d2">Learning-Free Multi-Robot Baseline is a baseline method that does not use learning to optimize monitoring accuracy in multi-robot systems.</data>
      <data key="d3">chunk-e3c7bf6aa95dbbb47a5109f81b1a609e</data>
      <data key="d4">2604.23179v1</data>
      <data key="d5">1780356863</data>

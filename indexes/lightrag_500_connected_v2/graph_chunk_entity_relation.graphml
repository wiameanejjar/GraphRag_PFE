    <node id="Ddpo Algorithm">
      <data key="d0">Ddpo Algorithm</data>
      <data key="d1">method</data>
      <data key="d2">The DDPO algorithm is a multi-turn GRPO-based approach designed to preserve dialogue diversity while holistically optimizing dialogue quality.</data>

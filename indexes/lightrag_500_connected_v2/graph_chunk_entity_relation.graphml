      <data key="d12">1780373525</data>
      <data key="d13" />
    </edge>
    <edge source="Data Vendors" target="Deploying Organizations">
      <data key="d7">1.0</data>
      <data key="d8">Deploying organizations rely on data vendors for necessary data, which may be provided with proprietary configurations that hinder integrated evaluation of bias.</data>
      <data key="d9">proprietary configurations,vendor-supplier relationship</data>
      <data key="d10">chunk-8a9bb4320aa0f6b0b69b9c0e565dafeb</data>

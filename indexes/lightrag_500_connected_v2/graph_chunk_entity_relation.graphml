    </edge>
    <edge source="Certification Framework" target="Grading Of Human Contribution">
      <data key="d7">1.0</data>
      <data key="d8">The framework grades contributions as Category A (pipeline-reachable), Category B (requiring human direction at identifiable stages), and Category C (beyond current pipeline reach at the formulation stage).</data>
      <data key="d9">framework,method relationship</data>
      <data key="d10">chunk-f92416ce1ab40a1abd7e32f118a086c3</data>
      <data key="d11">2604.22026v1</data>
      <data key="d12">1780404747</data>
      <data key="d13" />
    </edge>
    <edge source="Certification Framework" target="Frontier Human Contribution">
      <data key="d7">1.0</data>
      <data key="d8">The framework grounds recognition of frontier human contribution in epistemic achievement rather than unverifiable claims of human origin.</data>
      <data key="d9">concept relationship,framework</data>

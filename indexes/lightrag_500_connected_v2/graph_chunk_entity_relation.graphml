    <node id="Diadata">
      <data key="d0">Diadata</data>
      <data key="d1">dataset</data>
      <data key="d2">DiaData is a large CGM dataset of patients with T1D, ranging from children to seniors, used in this work for hypoglycemia classification.</data>

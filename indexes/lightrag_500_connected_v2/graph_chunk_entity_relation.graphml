    <node id="Human Annotations">
      <data key="d0">Human Annotations</data>
      <data key="d1">method</data>
      <data key="d2">Human annotations are a costly method of measuring SPB, which conflate generative capability with evaluative stance.</data>
      <data key="d3">chunk-879cb5db2211c2283dd060ddcd2850ac</data>
      <data key="d4">2604.22891v1</data>
      <data key="d5">1780384159</data>

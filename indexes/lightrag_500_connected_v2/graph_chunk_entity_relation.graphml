    <node id="Laws Of The Game">
      <data key="d0">Laws Of The Game</data>
      <data key="d1">concept</data>
      <data key="d2">The Laws of the Game are a set of rules governing soccer refereeing.</data>
      <data key="d3">chunk-f1127a0edecff6fc34fa6978e506b889</data>
      <data key="d4">2604.23392v1</data>
      <data key="d5">1780342180</data>
      <data key="d6" />
    </node>
    <node id="Soccer Refereeing">
      <data key="d0">Soccer Refereeing</data>
      <data key="d1">task</data>
      <data key="d2">Soccer refereeing involves making fair, accurate, and explainable decisions during soccer games.</data>
      <data key="d3">chunk-f1127a0edecff6fc34fa6978e506b889</data>
      <data key="d4">2604.23392v1</data>
      <data key="d5">1780342180</data>
      <data key="d6" />
    </node>
    <node id="A Parametric Memory Head For Continual Generative Retrieval">
      <data key="d0">A Parametric Memory Head For Continual Generative Retrieval</data>
      <data key="d1">model</data>
      <data key="d2">A Parametric Memory Head for Continual Generative Retrieval is a model that addresses the stability-plasticity trade-off in continual generative retrieval.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342869</data>
      <data key="d6" />
    </node>
    <node id="Generative Information Retrieval (Genir)">
      <data key="d0">Generative Information Retrieval (Genir)</data>
      <data key="d1">concept</data>
      <data key="d2">GenIR consolidates retrieval into a single neural model that decodes document identifiers directly from queries.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342869</data>
      <data key="d6" />
    </node>
    <node id="Ms Marco">
      <data key="d0">Ms Marco</data>
      <data key="d1">dataset</data>
      <data key="d2">MS MARCO is a dataset used for evaluating the performance of GenIR models.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342876</data>
      <data key="d6" />
    </node>
    <node id="Natural Questions">
      <data key="d0">Natural Questions</data>
      <data key="d1">dataset</data>
      <data key="d2">Natural Questions is another dataset used for evaluating the performance of GenIR models.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342876</data>
      <data key="d6" />
    </node>
    <node id="Parametric Memory Head (Pmh)">
      <data key="d0">Parametric Memory Head (Pmh)</data>
      <data key="d1">model</data>
      <data key="d2">The PMH is a modular parametric memory head that augments an adapted model with a product-key memory and fixed addressing.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342880</data>
      <data key="d6" />
    </node>
    <node id="Post-Adaptation Memory Tuning (Pamt)">
      <data key="d0">Post-Adaptation Memory Tuning (Pamt)</data>
      <data key="d1">method</data>
      <data key="d2">PAMT is a memory-only stabilization stage that addresses the stability-plasticity trade-off in GenIR.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342880</data>
      <data key="d6" />
    </node>
    <node id="Prefix-Trie Constrained Decoding">
      <data key="d0">Prefix-Trie Constrained Decoding</data>
      <data key="d1">method</data>
      <data key="d2">Prefix-trie constrained decoding is a method used to guide docid generation while keeping routing and backbone parameters fixed.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342884</data>
      <data key="d6" />
    </node>
    <node id="Sequential Adaptation">
      <data key="d0">Sequential Adaptation</data>
      <data key="d1">method</data>
      <data key="d2">Sequential adaptation improves retrieval on newly added documents but degrades performance on earlier slices.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342884</data>
      <data key="d6" />
    </node>
    <node id="Adapted Model">
      <data key="d0">Adapted Model</data>
      <data key="d1">model</data>
      <data key="d2">The adapted model is a model that has been updated using sequential adaptation.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342889</data>
      <data key="d6" />
    </node>
    <node id="Backbone Parameters">
      <data key="d0">Backbone Parameters</data>
      <data key="d1">modelcomponent</data>
      <data key="d2">The backbone parameters are a component of the model that is kept fixed during adaptation.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342889</data>
      <data key="d6" />
    </node>
    <node id="Catastrophic Forgetting">
      <data key="d0">Catastrophic Forgetting</data>
      <data key="d1">concept</data>
      <data key="d2">Catastrophic forgetting refers to the phenomenon where a model forgets previously learned information when adapting to new data.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342893</data>
      <data key="d6" />
    </node>
    <node id="Cross-Slice Interference">
      <data key="d0">Cross-Slice Interference</data>
      <data key="d1">concept</data>
      <data key="d2">Cross-slice interference refers to the phenomenon where a model's performance on earlier slices is degraded due to adaptation to new data.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342893</data>
      <data key="d6" />
    </node>
    <node id="Decoding-Time Access Statistics">
      <data key="d0">Decoding-Time Access Statistics</data>
      <data key="d1">modelcomponent</data>
      <data key="d2">Decoding-time access statistics are used by PAMT to select a fixed budget of memory values that are frequently activated by the current slice and rarely used in prior sessions.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342897</data>
      <data key="d6" />
    </node>
    <node id="Docid Generation">
      <data key="d0">Docid Generation</data>
      <data key="d1">concept</data>
      <data key="d2">Docid generation refers to the process of generating document identifiers from queries.</data>
      <data key="d3">chunk-2437b7e8219be59201ce384133e150d2</data>
      <data key="d4">2604.23388v1</data>
      <data key="d5">1780342897</data>
      <data key="d6" />

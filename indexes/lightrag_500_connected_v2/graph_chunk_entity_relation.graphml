    <node id="Upstreamqa">
      <data key="d0">Upstreamqa</data>
      <data key="d1">model</data>
      <data key="d2">UpstreamQA is a modular framework designed to enhance interpretability and multi-hop reasoning accuracy in video question answering tasks through explicit upstream reasoning modules.</data>

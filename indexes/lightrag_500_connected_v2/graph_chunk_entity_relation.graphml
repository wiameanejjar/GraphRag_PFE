    <node id="Constraint Satisfaction Problem">
      <data key="d0">Constraint Satisfaction Problem</data>
      <data key="d1">concept</data>
      <data key="d2">A constraint satisfaction problem is a mathematical formulation of the reasoning shortcut problem, which involves finding valid solutions that satisfy given constraints.</data>
      <data key="d3">chunk-8b661d44ac0479d8113583804dd72adc</data>
      <data key="d4">2604.23377v1</data>
      <data key="d5">1780343998</data>

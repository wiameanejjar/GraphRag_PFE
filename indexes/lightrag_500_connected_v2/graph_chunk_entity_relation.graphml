    <node id="Logic Landmines">
      <data key="d0">Logic Landmines</data>
      <data key="d1">concept</data>
      <data key="d2">Logic landmines are dormant, latent forms of poisoning embedded during pretraining that remain largely invisible under standard evaluation but can be activated by precise alphanumeric triggers.</data>
      <data key="d3">chunk-8084488ac0f355725aa1f5bce383f709</data>
      <data key="d4">2604.22117v1</data>
      <data key="d5">1780397969</data>

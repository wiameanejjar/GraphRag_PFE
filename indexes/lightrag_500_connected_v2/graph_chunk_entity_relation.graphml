    <node id="Router Initialization Trap">
      <data key="d0">Router Initialization Trap</data>
      <data key="d1">concept</data>
      <data key="d2">The router initialization trap refers to a failure mode where the model fails to escape shallow equilibrium due to incorrect initialization bias.</data>
      <data key="d3">chunk-ad110990ca6cc9a17e5632b94fa3fe51</data>
      <data key="d4">2604.21999v2</data>
      <data key="d5">1780426710</data>

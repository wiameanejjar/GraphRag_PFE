    <node id="Discrimination Property">
      <data key="d0">Discrimination Property</data>
      <data key="d1">concept</data>
      <data key="d2">The discrimination property is a necessary condition for shortcut-freeness under bijective mappings, requiring that no valid concept mapping can be transformed into another valid mapping by swapping two concept values.</data>
      <data key="d3">chunk-8b661d44ac0479d8113583804dd72adc</data>
      <data key="d4">2604.23377v1</data>
      <data key="d5">1780344005</data>
